#pragma once

#include <wx/geometry.h>

class Transform2D
{
public:
    Transform2D() = default;
    ~Transform2D() = default;

    void SetPosition(double x, double y);
    void SetPosition(const wxPoint2DDouble& p);

    void SetScale(double sx, double sy);
    void SetScale(const wxPoint2DDouble& s);

    void SetRotation(double degrees);
    void SetPivot(double x, double y);
    void SetPivot(const wxPoint2DDouble& p);

    void Translate(double dx, double dy);
    void RotateBy(double deltaDegrees);

    const wxPoint2DDouble& GetPosition() const { return m_position; }
    const wxPoint2DDouble& GetScale() const { return m_scale; }
    double GetRotation() const { return m_rotationDeg; }
    const wxPoint2DDouble& GetPivot() const { return m_pivot; }

    // Helpers (no wxAffineMatrix2D needed)
    wxPoint2DDouble LocalToWorld(const wxPoint2DDouble& localPt) const;
    wxPoint2DDouble WorldToLocal(const wxPoint2DDouble& worldPt) const;

private:
    wxPoint2DDouble m_position { 0.0, 0.0 };
    wxPoint2DDouble m_scale    { 1.0, 1.0 };
    double          m_rotationDeg = 0.0;
    wxPoint2DDouble m_pivot    { 0.0, 0.0 };
};


// ========== FILE: Transform2D.cpp ==========
#include "Transform2D.h"
#include <cmath>

namespace
{
    constexpr double kPi = 3.14159265358979323846;

    inline double DegToRad(double deg)
    {
        return deg * kPi / 180.0;
    }
}

void Transform2D::SetPosition(double x, double y) { m_position = wxPoint2DDouble(x, y); }
void Transform2D::SetPosition(const wxPoint2DDouble& p) { m_position = p; }

void Transform2D::SetScale(double sx, double sy) { m_scale = wxPoint2DDouble(sx, sy); }
void Transform2D::SetScale(const wxPoint2DDouble& s) { m_scale = s; }

void Transform2D::SetRotation(double degrees) { m_rotationDeg = degrees; }

void Transform2D::SetPivot(double x, double y) { m_pivot = wxPoint2DDouble(x, y); }
void Transform2D::SetPivot(const wxPoint2DDouble& p) { m_pivot = p; }

void Transform2D::Translate(double dx, double dy)
{
    m_position.m_x += dx;
    m_position.m_y += dy;
}

void Transform2D::RotateBy(double deltaDegrees)
{
    m_rotationDeg += deltaDegrees;
}

wxPoint2DDouble Transform2D::LocalToWorld(const wxPoint2DDouble& localPt) const
{
    // world = T(pos) * R(rot) * S(scale) * T(-pivot) * local
    double x = localPt.m_x - m_pivot.m_x;
    double y = localPt.m_y - m_pivot.m_y;

    // Scale
    x *= m_scale.m_x;
    y *= m_scale.m_y;

    // Rotate
    const double r = DegToRad(m_rotationDeg);
    const double c = std::cos(r);
    const double s = std::sin(r);

    const double xr = x * c - y * s;
    const double yr = x * s + y * c;

    // Translate
    return wxPoint2DDouble(xr + m_position.m_x, yr + m_position.m_y);
}

wxPoint2DDouble Transform2D::WorldToLocal(const wxPoint2DDouble& worldPt) const
{
    // Inverse of LocalToWorld:
    // local = T(+pivot) * S^-1 * R^-1 * T(-pos) * world
    double x = worldPt.m_x - m_position.m_x;
    double y = worldPt.m_y - m_position.m_y;

    // Inverse rotate
    const double r = DegToRad(-m_rotationDeg);
    const double c = std::cos(r);
    const double s = std::sin(r);

    const double xr = x * c - y * s;
    const double yr = x * s + y * c;

    // Inverse scale (guard zero)
    double lx = xr;
    double ly = yr;

    if (std::abs(m_scale.m_x) > 1e-12) lx /= m_scale.m_x;
    if (std::abs(m_scale.m_y) > 1e-12) ly /= m_scale.m_y;

    // Add pivot back
    lx += m_pivot.m_x;
    ly += m_pivot.m_y;

    return wxPoint2DDouble(lx, ly);
}

