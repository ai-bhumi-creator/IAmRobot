// ======================================================
TimelinePanel::LeftHeaderPanel::LeftHeaderPanel(TimelinePanel* owner, wxWindow* parent, Document* doc)
    : wxPanel(parent, wxID_ANY), m_owner(owner), m_doc(doc)
{
    SetBackgroundStyle(wxBG_STYLE_PAINT);
    SetDoubleBuffered(true);
    SetBackgroundColour(wxColour(45, 45, 45));
}

void TimelinePanel::LeftHeaderPanel::OnPaint(wxPaintEvent& e)
{
    wxAutoBufferedPaintDC dc(this);
    dc.SetBackground(wxBrush(GetBackgroundColour()));
    dc.Clear();

    if (!m_doc)
        return;

    const wxSize cs = GetClientSize();
    const int layerCount = m_doc->GetLayerCount();

    // top-left block above layer names
    dc.SetPen(*wxTRANSPARENT_PEN);
    dc.SetBrush(wxBrush(wxColour(65, 65, 65)));
    dc.DrawRectangle(0, 0, cs.x, TimelinePanel::RULER_H);

    // bottom line under ruler/header
    dc.SetPen(wxPen(wxColour(80, 80, 80)));
    dc.DrawLine(0, TimelinePanel::RULER_H - 1, cs.x, TimelinePanel::RULER_H - 1);

    for (int li = 0; li < layerCount; ++li)
    {
        const int y = TimelinePanel::RULER_H + li * TimelinePanel::ROW_H;
        Layer* L = m_doc->GetLayer(li);

        dc.SetPen(*wxTRANSPARENT_PEN);
        dc.SetBrush(wxBrush(li == m_doc->GetActiveLayerIndex()
                                ? wxColour(70, 70, 70)
                                : wxColour(55, 55, 55)));
        dc.DrawRectangle(0, y, cs.x, TimelinePanel::ROW_H);

        dc.SetTextForeground(*wxWHITE);
        if (L)
            dc.DrawText(L->GetName(), 6, y + 3);
    }

    // Top separator line
    dc.SetPen(wxPen(wxColour(74, 74, 74), 1));
    dc.DrawLine(0, 0, cs.x, 0);

    // Right separator line
    dc.DrawLine(cs.x - 1, 0, cs.x - 1, cs.y);
}

void TimelinePanel::LeftHeaderPanel::OnLeftDown(wxMouseEvent& e)
{
    if (!m_doc)
        return;

    const wxPoint p = e.GetPosition();

    if (p.y < TimelinePanel::RULER_H)
        return;

    const int layerIndex = (p.y - TimelinePanel::RULER_H) / TimelinePanel::ROW_H;
    if (layerIndex < 0 || layerIndex >= m_doc->GetLayerCount())
        return;

    m_doc->SetActiveLayerIndex(layerIndex);

    if (m_owner)
        m_owner->RefreshAll();
}

