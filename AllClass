wxPanel* MainFrame::CreatePlaceholderPanel(wxWindow* parent, const wxString& label)
{
    Centre();

    wxPanel* panel = new wxPanel(parent, wxID_ANY);

    wxBoxSizer* sizer = new wxBoxSizer(wxVERTICAL);
    wxStaticText* text = new wxStaticText(panel, wxID_ANY, label);
    text->SetForegroundColour(*wxWHITE);

    sizer->AddSpacer(10);
    sizer->Add(text, 0, wxLEFT | wxTOP, 10);
    panel->SetSizer(sizer);

    return panel;
