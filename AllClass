    modifyMenu->Append(ID_MODIFY_DOCUMENT, "Document Properties...\tCtrl+J");

    // Text menu
    wxMenu* textMenu = new wxMenu();

    // Control menu
    wxMenu* controlMenu = new wxMenu();

    // Window menu
    wxMenu* windowMenu = new wxMenu();

    // Help menu
    wxMenu* helpMenu = new wxMenu;
    helpMenu->Append(ID_HELP_ABOUT, "&About\tF1");

    // Menu bar
