public:
    PropertiesPanel(wxWindow* parent);

    void SetZero();
    void SetDashed();
    void SetFields(double x, double y, double w, double h);

    void SetTarget(Document* doc, DisplayObject* selected, int selectedSegmentIndex = -1);

    // Current UI style (used as defaults for new paths)
    wxColour GetCurrentFillColor() const { return GetPreviewColor(fillColorPreview); }
    wxColour GetCurrentStrokeColor() const { return GetPreviewColor(strokeColorPreview); }
    double GetCurrentStrokeWidth() const;

    void UpdateSectionsForSelection(bool isPath, bool isText, bool isImage);

private:
    void SetPreviewColor(wxPanel* preview, const wxColour& c);
    wxColour GetPreviewColor(wxPanel* preview) const;

    void SetStrokeWidthUI(double v);

