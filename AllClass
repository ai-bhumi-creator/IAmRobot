#include "Document.h"

Document::Document()
{
    AddLayer("Layer 1");
    EnsureFramesExist(0);
}

void Document::SetCurrentFrame(int f)
{
    if (f < 0) f = 0;

    if (f >= m_timelineLength)
        return;

    m_currentFrame = f;
    EnsureFramesExist(m_currentFrame);
}

void Document::SetActiveLayerIndex(int idx)
{
    if (m_layers.empty())
    {
        m_activeLayer = 0;
        return;
    }

    if (idx < 0) idx = 0;
    if (idx >= (int)m_layers.size()) idx = (int)m_layers.size() - 1;
    m_activeLayer = idx;
}

Layer* Document::GetLayer(int idx)
{
    if (idx < 0 || idx >= (int)m_layers.size())
        return nullptr;
    return m_layers[idx].get();
}

const Layer* Document::GetLayer(int idx) const
{
    if (idx < 0 || idx >= (int)m_layers.size())
        return nullptr;
    return m_layers[idx].get();
}

Layer* Document::AddLayer(const std::string& name)
{
    m_layers.push_back(std::make_unique<Layer>(name));
    m_layers.back()->ResizeFrames(m_timelineLength);
    return m_layers.back().get();
}

void Document::EnsureFramesExist(int frameIndex)
{
    for (auto& L : m_layers)
        L->ResizeFrames(frameIndex + 1);
}

Frame* Document::EnsureActiveFrame()
{
    Layer* L = GetLayer(m_activeLayer);
    if (!L) return nullptr;

    EnsureFramesExist(m_currentFrame);
    return L->EnsureFrame(m_currentFrame);
}

void Document::Select(DisplayObject* obj)
{
    m_selected = obj;
    m_gizmo.SetTarget(obj);
}

void Document::ClearSelection()
{
    m_selected = nullptr;
    m_gizmo.SetTarget(nullptr);
}

void Document::EnsureTimelineLength(int len)
{
    if (len < 1) len = 1;
    if (len <= m_timelineLength) return;

    m_timelineLength = len;
    EnsureFramesExist(m_timelineLength - 1);
}

bool Document::CanGoToFrame(int frameIndex) const
{
    return frameIndex >= 0 && frameIndex < m_timelineLength;
}

void Document::AddObjectToActiveFrame(std::unique_ptr<DisplayObject> obj)
{
    Frame* frame = EnsureActiveFrame();
    if (!frame || !obj)
        return;

    DisplayObject* raw = obj.get();
    frame->AddObject(std::move(obj));
    Select(raw);
}

void Document::DrawCurrent(wxGraphicsContext* gc, double zoom)
{
    for (auto& L : m_layers)
        if (L) L->DrawFrame(gc, m_currentFrame);

    if (m_selected)
        m_selected->DrawSelection(gc, zoom);

    m_gizmo.Draw(gc, zoom);
}

