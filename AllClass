    void SetName(const std::string& name) { m_name = name; }
    const std::string& GetName() const { return m_name; }

    void SetVisible(bool v) { m_visible = v; }
    bool IsVisible() const { return m_visible; }

    void SetLocked(bool v) { m_locked = v; }
    bool IsLocked() const { return m_locked; }

    int GetFrameCount() const { return static_cast<int>(m_frames.size()); }

    // Ensure frames [0..count-1] exist
    void ResizeFrames(int count);

    // Access
    Frame* GetFrame(int index);
    const Frame* GetFrame(int index) const;

    // Creates missing frames up to index and returns it
    Frame* EnsureFrame(int index);

    // Draw current frame
    void DrawFrame(wxGraphicsContext* gc, int frameIndex);

    // Hit test current frame (top-most in this layer)
    DisplayObject* HitTestFrameTop(const wxPoint2DDouble& worldPt, int frameIndex);

private:
    std::string m_name = "Layer";
    bool m_visible = true;
    bool m_locked = false;

    std::vector<std::unique_ptr<Frame>> m_frames;
};


// ========== FILE: Layer.cpp ==========
#include "Layer.h"

void Layer::ResizeFrames(int count)
{
    if (count < 0) count = 0;

    const int oldCount = static_cast<int>(m_frames.size());
    if (count == oldCount) return;

    if (count < oldCount)
    {
        m_frames.resize(static_cast<size_t>(count));
        return;
    }

    m_frames.reserve(static_cast<size_t>(count));
    for (int i = oldCount; i < count; ++i)
    {
        m_frames.push_back(std::make_unique<Frame>(i));
    }
}

Frame* Layer::GetFrame(int index)
{
    if (index < 0 || index >= static_cast<int>(m_frames.size()))
        return nullptr;
    return m_frames[static_cast<size_t>(index)].get();
}

const Frame* Layer::GetFrame(int index) const
{
    if (index < 0 || index >= static_cast<int>(m_frames.size()))
        return nullptr;
    return m_frames[static_cast<size_t>(index)].get();
}

Frame* Layer::EnsureFrame(int index)
{
    if (index < 0)
        return nullptr;

    if (index >= static_cast<int>(m_frames.size()))
        ResizeFrames(index + 1);

    return GetFrame(index);
}

void Layer::DrawFrame(wxGraphicsContext* gc, int frameIndex)
{
    if (!gc || !m_visible) return;

    Frame* f = GetFrame(frameIndex);
    if (!f) return;

    f->Draw(gc);
}

DisplayObject* Layer::HitTestFrameTop(const wxPoint2DDouble& worldPt, int frameIndex)
{
    if (!m_visible || m_locked)
        return nullptr;

    Frame* f = GetFrame(frameIndex);
    if (!f)
        return nullptr;

    return f->HitTestTop(worldPt);
}

