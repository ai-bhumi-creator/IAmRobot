void Frame::AddObject(std::unique_ptr<DisplayObject> obj)
{
    if (!obj) return;
    m_objects.push_back(std::move(obj));
}

void Frame::ClearObjects()
{
    m_objects.clear();
}

DisplayObject* Frame::HitTestTop(const wxPoint2DDouble& worldPt)
{
    for (auto it = m_objects.rbegin(); it != m_objects.rend(); ++it)
    {
        DisplayObject* obj = it->get();
        if (!obj || !obj->IsVisible() || obj->IsLocked())
            continue;

        if (obj->HitTestWorld(worldPt))
            return obj;
    }
    return nullptr;
}

void Frame::Draw(wxGraphicsContext* gc)
{
    if (!gc) return;

    for (auto& obj : m_objects)
    {
        if (obj)
            obj->Draw(gc);
    }
}

