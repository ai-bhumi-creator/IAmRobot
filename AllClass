#include "ImageDisplayObject.h"

ImageDisplayObject::ImageDisplayObject()
    : DisplayObject(DisplayObjectType::Image)
{
}

bool ImageDisplayObject::LoadFromFile(const wxString& path)
{
    wxImage img;
    if (!img.LoadFile(path) || !img.IsOk())
        return false;

    m_bitmap = wxBitmap(img);
    if (!m_bitmap.IsOk())
        return false;

    m_sourcePath = path;
    m_width = m_bitmap.GetWidth();
    m_height = m_bitmap.GetHeight();
    return true;
}

wxRect2DDouble ImageDisplayObject::GetLocalBounds() const
{
    return wxRect2DDouble(0.0, 0.0, (double)m_width, (double)m_height);
}

bool ImageDisplayObject::HitTestWorld(const wxPoint2DDouble& worldPt) const
{
    const wxPoint2DDouble localPt = WorldToLocal(worldPt);
    const wxRect2DDouble bounds = GetLocalBounds();
    return bounds.Contains(localPt);
}

void ImageDisplayObject::Draw(wxGraphicsContext* gc)
{
    if (!gc || !m_bitmap.IsOk() || !IsVisible())
        return;

    gc->PushState();

    const Transform2D& t = GetTransform();
    const wxPoint2DDouble pos = t.GetPosition();
    const wxPoint2DDouble scale = t.GetScale();
    const wxPoint2DDouble pivot = t.GetPivot();

    // Position already represents the world-space pivot location.
    gc->Translate(pos.m_x, pos.m_y);
    gc->Rotate(t.GetRotation() * 3.14159265358979323846 / 180.0);
    gc->Scale(scale.m_x, scale.m_y);
    gc->Translate(-pivot.m_x, -pivot.m_y);

    gc->DrawBitmap(m_bitmap, 0.0, 0.0, (double)m_width, (double)m_height);

    gc->PopState();
}

