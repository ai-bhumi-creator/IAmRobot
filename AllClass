class ViewportBoard
{
public:
    enum class RulerUnit
    {
        Pixels = 0,
        Inches,
        Centimeters
    };

    // ---- Defaults (single source of truth) ----
    static constexpr double DEFAULT_X = 0.0;
    static constexpr double DEFAULT_Y = 0.0;
    static constexpr double DEFAULT_W = 640.0;
    static constexpr double DEFAULT_H = 480.0;
    static constexpr int    DEFAULT_FRAME_RATE = 24;
    static constexpr RulerUnit DEFAULT_RULER_UNIT = RulerUnit::Pixels;

    static wxColour DefaultBackgroundColor()
    {
        return wxColour(255, 255, 255);
    }

    ViewportBoard()
        : m_x(DEFAULT_X),
          m_y(DEFAULT_Y),
          m_w(DEFAULT_W),
          m_h(DEFAULT_H),
          m_bgColor(DefaultBackgroundColor()),
          m_frameRate(DEFAULT_FRAME_RATE),
          m_rulerUnit(DEFAULT_RULER_UNIT)
    {
    }

    // Geometry
    double GetX() const { return m_x; }
    double GetY() const { return m_y; }
    double GetWidth() const { return m_w; }
    double GetHeight() const { return m_h; }

    void SetPosition(double x, double y) { m_x = x; m_y = y; }
    void SetSize(double w, double h)
    {
        if (w > 0.0) m_w = w;
        if (h > 0.0) m_h = h;
    }

    // Appearance
    const wxColour& GetBackgroundColor() const { return m_bgColor; }
    void SetBackgroundColor(const wxColour& c) { m_bgColor = c; }

    // Settings
    int GetFrameRate() const { return m_frameRate; }
    void SetFrameRate(int fps)
    {
        if (fps > 0) m_frameRate = fps;
    }

    RulerUnit GetRulerUnit() const { return m_rulerUnit; }
    void SetRulerUnit(RulerUnit unit) { m_rulerUnit = unit; }

    static wxString RulerUnitToString(RulerUnit unit)
    {
        switch (unit)
        {
            case RulerUnit::Pixels:      return "Pixels";
            case RulerUnit::Inches:      return "Inches";
            case RulerUnit::Centimeters: return "Centimeters";
        }
        return "Pixels";
    }

    static RulerUnit RulerUnitFromIndex(int idx)
    {
        switch (idx)
        {
            case 1: return RulerUnit::Inches;
            case 2: return RulerUnit::Centimeters;
            case 0:
            default: return RulerUnit::Pixels;
        }
    }

    static int RulerUnitToIndex(RulerUnit unit)
    {
        switch (unit)
        {
            case RulerUnit::Pixels:      return 0;
            case RulerUnit::Inches:      return 1;
            case RulerUnit::Centimeters: return 2;
        }
        return 0;
    }

    void ResetToDefaults()
    {
        m_x = DEFAULT_X;
        m_y = DEFAULT_Y;
        m_w = DEFAULT_W;
        m_h = DEFAULT_H;
        m_bgColor = DefaultBackgroundColor();
        m_frameRate = DEFAULT_FRAME_RATE;
        m_rulerUnit = DEFAULT_RULER_UNIT;
    }

private:
    double m_x;
    double m_y;
    double m_w;
    double m_h;
    wxColour m_bgColor;
    int m_frameRate;
    RulerUnit m_rulerUnit;
};


















