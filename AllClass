// Image instance placed on the stage.
// Holds transform/state + reference/data needed to draw an image asset.
class ImageObject : public DisplayObject
{
public:
    ImageObject();
    ~ImageObject() override = default;

    // Asset link (recommended for your asset manager integration)
    void SetAssetId(const std::string& assetId) { m_assetId = assetId; }
    const std::string& GetAssetId() const { return m_assetId; }

    // Optional direct image assignment for early testing/prototyping
    void SetBitmap(const wxBitmap& bmp);
    const wxBitmap& GetBitmap() const { return m_bitmap; }
    bool HasBitmap() const { return m_bitmap.IsOk(); }

    // Local content size (used for bounds/hit testing)
    void SetNativeSize(double w, double h);
    wxSize GetNativeSize() const { return m_nativeSize; }

    // DisplayObject overrides
    wxRect2DDouble GetLocalBounds() const override;
    bool HitTestWorld(const wxPoint2DDouble& worldPt) const override;
    void Draw(wxGraphicsContext* gc) override;

private:
    std::string m_assetId;

    wxBitmap m_bitmap;          // Optional direct render source
    wxSize   m_nativeSize{0,0}; // Intrinsic size in local space
};


