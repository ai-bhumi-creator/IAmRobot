static wxArrayString GetSystemFontFaceNames()
{
    wxFontEnumerator enumerator;
    wxArrayString fonts = enumerator.GetFacenames();

    fonts.Sort();

    wxArrayString filtered;
    filtered.Alloc(fonts.size());

    wxString lastAddedLower;

    for (const auto& name : fonts)
    {
        wxString cleanName = name;
        cleanName.Trim(true);
        cleanName.Trim(false);

        if (cleanName.IsEmpty())
            continue;

        const wxString lower = cleanName.Lower();

        if (filtered.IsEmpty() || lower != lastAddedLower)
        {
            filtered.Add(cleanName);
            lastAddedLower = lower;
        }
    }

    return filtered;
}

static PathDisplayObject* AsPath(DisplayObject* o)
{
    if (!o) return nullptr;
    if (o->GetType() != DisplayObjectType::Path) return nullptr;
    return static_cast<PathDisplayObject*>(o);
}

static void RefreshUp(wxWindow* w)
{
    // simple + reliable: repaint up the parent chain
    wxWindow* p = w;
    while (p)
    {
        p->Refresh(false);
        p = p->GetParent();
    }
}

static wxTextCtrl* MakeReadOnly(wxWindow* parent)
{
    return new wxTextCtrl(parent, wxID_ANY, "", wxDefaultPosition, wxDefaultSize, wxTE_READONLY);
}

static wxString F(double v)
{
    return wxString::Format("%.2f", v);
}

PropertiesPanel::PropertiesPanel(wxWindow* parent)
    : wxPanel(parent)
{
    auto* root = new wxBoxSizer(wxVERTICAL);

    BuildTransformSection(root);
    BuildPathSection(root);
    BuildTextSection(root);
    BuildImageSection(root);

    SetSizer(root);
    SetMinSize(wxSize(340, -1));

    // Default preview colors
    SetPreviewColor(fillColorPreview, *wxWHITE);
    SetPreviewColor(strokeColorPreview, *wxBLACK);
    SetStrokeWidthUI(2.0);

    // UI only
    fillColorPreview->Bind(wxEVT_LEFT_DOWN, &PropertiesPanel::OnFillPreviewClick, this);
    strokeColorPreview->Bind(wxEVT_LEFT_DOWN, &PropertiesPanel::OnStrokePreviewClick, this);
    strokeWidthSlider->Bind(wxEVT_SLIDER, &PropertiesPanel::OnStrokeSlider, this);

    if (textColorPreview)
        textColorPreview->Bind(wxEVT_LEFT_DOWN, &PropertiesPanel::OnTextColorPreviewClick, this);

    SetZero();

    // Initial visibility
    UpdateSectionsForSelection(false, false, false);

    Layout();
}

void PropertiesPanel::SetPreviewColor(wxPanel* preview, const wxColour& c)
{
    if (!preview)
        return;

    preview->SetBackgroundColour(c);
    preview->Refresh();
}

wxColour PropertiesPanel::GetPreviewColor(wxPanel* preview) const
{
    if (!preview)
        return *wxBLACK;

    return preview->GetBackgroundColour();
}

void PropertiesPanel::SetStrokeWidthUI(double v)
{
    v = std::clamp(v, 0.0, 50.0);

    if (strokeWidthSlider)
        strokeWidthSlider->SetValue((int)std::round(v * 10.0));

    if (strokeWidthCtrl)
        strokeWidthCtrl->SetValue(wxString::Format("%.2f", v));
}

