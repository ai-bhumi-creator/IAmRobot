#pragma once

#include <vector>
#include <wx/panel.h>
#include <wx/event.h>

#include "ViewportBoard.h"
#include "Document.h"

class CanvasViewport : public wxPanel
{
public:
    CanvasViewport(wxWindow* parent, ViewportBoard* stage, Document* doc);

    void SetPenToolActive(bool active);
    bool IsPenToolActive() const { return m_penToolActive; }

private:
    ViewportBoard* m_stage = nullptr;
    Document*      m_doc   = nullptr;

    wxCursor m_circleArrowCursor;

    // View transform
    double m_zoom = 1.0;
    double m_panX = 0.0;
    double m_panY = 0.0;

    // Middle-mouse panning
    bool m_isPanning = false;
    wxPoint m_lastMousePos;

    // Drag
    bool m_isDraggingObject = false;
    wxPoint2DDouble m_lastDragStagePos;

    // Scale
    bool m_isScalingObject = false;
    TransformGizmo::Handle m_activeHandle = TransformGizmo::Handle::None;
    wxPoint2DDouble m_scaleStartMouseStage;
    wxRect2DDouble m_scaleStartBounds;
    wxPoint2DDouble m_scaleStartPos;
    wxPoint2DDouble m_scaleStartScale;
    wxPoint2DDouble m_scaleStartPivot;

    // Rotation
    bool m_isRotatingObject = false;
    wxPoint2DDouble m_rotateStartMouseStage;
    wxPoint2DDouble m_rotateCenterStage;
    double m_rotateStartDegrees = 0.0;

    // Pen tool
    bool m_penToolActive = false;
    std::vector<wxPoint2DDouble> m_penPoints;
    wxPoint2DDouble m_penHoverStagePos;
    bool m_hasPenHoverStagePos = false;
    int m_penHoverPointIndex = -1;

    void OnPaint(wxPaintEvent& event);
    void OnSize(wxSizeEvent& event);

    void OnMouseWheel(wxMouseEvent& event);
    void OnMiddleDown(wxMouseEvent& event);
    void OnMiddleUp(wxMouseEvent& event);
    void OnMouseMove(wxMouseEvent& event);
    void OnMouseCaptureLost(wxMouseCaptureLostEvent& event);

    wxPoint2DDouble ClientToStage(const wxPoint& pt) const;
    void OnLeftDown(wxMouseEvent& event);
    void OnLeftUp(wxMouseEvent& event);

    void ApplyScaleFromHandle(const wxPoint2DDouble& currentStagePt, bool keepAspect);

    void UpdateTransformCursor(const wxPoint& clientPt);
    void OnLeaveWindow(wxMouseEvent& event);
    void GetStageDrawOrigin(double& drawX, double& drawY) const;

    void ApplyRotationFromMouse(const wxPoint2DDouble& currentStagePt);

    // Pen helpers
    bool IsStagePointInside(const wxPoint2DDouble& stagePt) const;
    int HitTestPenPoint(const wxPoint2DDouble& stagePt) const;
    void ResetPenPathPreview();
    void CompletePenPath();
    void DrawPenPreview(wxGraphicsContext* gc);

    wxDECLARE_EVENT_TABLE();
};

