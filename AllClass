// File menu
// ------------------------------------------------
void MainFrame::OnImportToStage(wxCommandEvent& event)
{
    wxFileDialog openFileDialog(
        this,
        "Import Image to Stage",
        "",
        "",
        "Image files (*.png;*.jpg;*.jpeg;*.bmp;*.gif)|*.png;*.jpg;*.jpeg;*.bmp;*.gif|All files (*.*)|*.*",
        wxFD_OPEN | wxFD_FILE_MUST_EXIST
    );

    if (openFileDialog.ShowModal() != wxID_OK)
        return;

    const wxString filePath = openFileDialog.GetPath();

    auto obj = std::make_unique<ImageDisplayObject>();
    if (!obj->LoadFromFile(filePath))
    {
        wxMessageBox("Failed to load image:\n" + filePath, "Import Error", wxOK | wxICON_ERROR, this);
        return;
    }

    const wxRect2DDouble b = obj->GetLocalBounds();

    obj->SetPivot(b.m_width * 0.5, b.m_height * 0.5);

    Transform2D& t = obj->GetTransform();
    t.SetPosition(b.m_width * 0.5, b.m_height * 0.5);
    t.SetRotation(0.0);
    t.SetScale(1.0, 1.0);

    m_doc.AddObjectToActiveFrame(std::move(obj));

    if (m_canvasPanel && m_canvasPanel->GetViewport())
        m_canvasPanel->GetViewport()->Refresh(false);
}

void MainFrame::OnExit(wxCommandEvent& event)
{
    Close(true);
}

// ------------------------------------------------
// Modify menu
// ------------------------------------------------
void MainFrame::OnDocumentProperties(wxCommandEvent& event)
{
    if (!m_canvasPanel)
        return;

    m_canvasPanel->ShowBoardSettingsDialog(event);
}

// ------------------------------------------------
// Help menu
// ------------------------------------------------
void MainFrame::OnAbout(wxCommandEvent& event)
{
    wxMessageBox("wxAUI base layout:\n"
                 "- Toolbar width 40\n"
                 "- Right tabs: Properties + Library\n"
                 "- Timeline under center area",
                 "About",
                 wxOK | wxICON_INFORMATION,
                 this);
}

void MainFrame::SetActiveTool(ToolType tool)
{
    m_activeTool = tool;

    if (m_toolSelection)
        m_toolSelection->SetValue(tool == ToolType::Selection);

    if (m_toolSubselection)
        m_toolSubselection->SetValue(tool == ToolType::Subselection);

    if (m_toolPen)
        m_toolPen->SetValue(tool == ToolType::Pen);
}

void MainFrame::OnToolSelection(wxCommandEvent& event)
{
    m_activeTool = ToolType::Selection;

    m_toolSelection->SetValue(true);
    m_toolSubselection->SetValue(false);
    m_toolPen->SetValue(false);
}

void MainFrame::OnToolSubselection(wxCommandEvent& event)
{
    m_activeTool = ToolType::Subselection;

    m_toolSelection->SetValue(false);
    m_toolSubselection->SetValue(true);
    m_toolPen->SetValue(false);
}

void MainFrame::OnToolPen(wxCommandEvent& event)
{
    m_activeTool = ToolType::Pen;

    m_toolSelection->SetValue(false);
    m_toolSubselection->SetValue(false);
    m_toolPen->SetValue(true);
}




