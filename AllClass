void MainFrame::ApplySubselectionToViewport()
{
    if (!m_canvasPanel)
        return;

    CanvasViewport* vp = m_canvasPanel->GetViewport();
    if (!vp)
        return;

    vp->SetSubselectionMode(m_activeTool == ToolType::Subselection);
    vp->SetSubToolType(m_subselectionTool);
    vp->Refresh(false);
}

void MainFrame::OnToolEditAnchor(wxCommandEvent& event)
{
    if (!event.IsChecked()) { m_toolEditAnchor->SetValue(true); return; }

    // Make sure we're in subselection tool
    if (m_activeTool != ToolType::Subselection)
        SetActiveTool(ToolType::Subselection);

    m_subselectionTool = SubToolType::EditAnchor;
    LastSelectToolId(ID_TOOL_EDIT_ANCHOR);

    ApplySubselectionToViewport();
}

void MainFrame::OnToolAddAnchor(wxCommandEvent& event)
{
    if (!event.IsChecked()) { m_toolAddAnchor->SetValue(true); return; }

    if (m_activeTool != ToolType::Subselection)
        SetActiveTool(ToolType::Subselection);

    m_subselectionTool = SubToolType::AddAnchor;
    LastSelectToolId(ID_TOOL_ADD_ANCHOR);

    ApplySubselectionToViewport();
}

void MainFrame::OnToolRemoveAnchor(wxCommandEvent& event)
{
    if (!event.IsChecked()) { m_toolRemoveAnchor->SetValue(true); return; }

    if (m_activeTool != ToolType::Subselection)
        SetActiveTool(ToolType::Subselection);

    m_subselectionTool = SubToolType::RemoveAnchor;
    LastSelectToolId(ID_TOOL_REMOVE_ANCHOR);

    ApplySubselectionToViewport();
}

void MainFrame::ShowHideSubselectionTool()
{
    const bool show = (m_activeTool == ToolType::Subselection);

    if (m_toolEditAnchor)   m_toolEditAnchor->Show(show);
    if (m_toolAddAnchor)    m_toolAddAnchor->Show(show);
    if (m_toolRemoveAnchor) m_toolRemoveAnchor->Show(show);

    if (m_toolsPanel)
        m_toolsPanel->Layout();

    if (m_toolsPanel && m_toolsPanel->GetSizer())
        m_toolsPanel->GetSizer()->Layout();
}

void MainFrame::LastSelectToolId(int toolId)
{
    m_lastAnchorToolId = toolId;

    m_toolEditAnchor->SetValue(toolId == ID_TOOL_EDIT_ANCHOR);
    m_toolAddAnchor->SetValue(toolId == ID_TOOL_ADD_ANCHOR);
    m_toolRemoveAnchor->SetValue(toolId == ID_TOOL_REMOVE_ANCHOR);
}

// Add a shared event handler for all three anchor buttons
void MainFrame::OnAnchorToolToggle(wxCommandEvent& event)
{
    // Prevent unchecking the active button — always keep one selected
    wxBitmapToggleButton* btn = dynamic_cast<wxBitmapToggleButton*>(event.GetEventObject());
    if (btn && !event.IsChecked())
    {
        btn->SetValue(true);
        return;
    }

    const int toolId = event.GetId();

    if (toolId == ID_TOOL_EDIT_ANCHOR)
        m_subselectionTool = SubToolType::EditAnchor;
    else if (toolId == ID_TOOL_ADD_ANCHOR)
        m_subselectionTool = SubToolType::AddAnchor;
    else if (toolId == ID_TOOL_REMOVE_ANCHOR)
        m_subselectionTool = SubToolType::RemoveAnchor;

    LastSelectToolId(toolId);
}

// ------------------------------------------------
// Delete library items
// ------------------------------------------------
void MainFrame::OnCharHook(wxKeyEvent& event)
{
    // Don't steal keys while user is typing in any text input (including our text overlay wxTextCtrl)
    wxWindow* focus = wxWindow::FindFocus();
    if (focus)
    {
        if (wxDynamicCast(focus, wxTextCtrl) || wxDynamicCast(focus, wxComboBox) || wxDynamicCast(focus, wxSpinCtrl) || wxDynamicCast(focus, wxSpinCtrlDouble))
        {
            event.Skip();
            return;
        }
    }

    // Ignore modified keys (we'll use Ctrl for undo/redo later)
    if (event.ControlDown() || event.AltDown() || event.MetaDown())
    {
        event.Skip();
        return;
    }

    int key = event.GetKeyCode();

    // Normalize lowercase -> uppercase
    if (key >= 'a' && key <= 'z')
        key = key - 'a' + 'A';

    switch (key)
    {
    case 'V': // Selection
        SetActiveTool(ToolType::Selection);
        break;

    case 'A': // Subselection (EditAnchor)
        m_subselectionTool = SubToolType::EditAnchor;
        SetActiveTool(ToolType::Subselection);
        // Optional: keep your UI remembering last anchor tool
        // LastSelectToolId(ID_TOOL_EDIT_ANCHOR);
        break;

    case 'P': // Pen
        SetActiveTool(ToolType::Pen);
        break;

    case 'R': // Rectangle
        SetActiveTool(ToolType::Rectangle);
        break;

    case 'O': // Ellipse
        SetActiveTool(ToolType::Ellipse);
        break;

    case 'L': // Line
        SetActiveTool(ToolType::Line);
        break;

    case 'T': // Text
        SetActiveTool(ToolType::Text);
        break;

    default:
        event.Skip();
        return;
    }

    // We handled it
    event.Skip(false);
}

void MainFrame::RemoveSelectedFromStage()
{
    if (!m_doc.RemoveSelectedObjectFromActiveFrame())
        return;

    RefreshPropertiesPanelFromSelection();

    if (m_libraryPanel)
        m_libraryPanel->Refresh(false);

    if (m_timelinePanel)
        m_timelinePanel->RefreshAll();

    if (m_canvasPanel && m_canvasPanel->GetViewport())
        m_canvasPanel->GetViewport()->Refresh(false);
}

void MainFrame::RefreshPropertiesPanelFromSelection()
{
    if (!m_propertiesPanel)
        return;

    int seg = -1;
    if (m_canvasPanel && m_canvasPanel->GetViewport())
        seg = m_canvasPanel->GetViewport()->GetSelectedSegmentIndex();

    m_propertiesPanel->SetTarget(&m_doc, m_doc.GetSelected(), seg);
}

void MainFrame::RemoveSelectedFromLibrary()
{
    if (!m_libraryPanel)
        return;

    const LibraryPanel::Item* selected = m_libraryPanel->GetSelectedItem();
    if (!selected)
        return;

    const std::string assetId = selected->id;
    const wxString itemName = selected->name;

    const int answer = wxMessageBox(
        "Remove \"" + itemName + "\" from Library?\n\nThis will also remove all its instances from the stage.",
        "Remove from Library",
        wxYES_NO | wxICON_WARNING,
        this
    );

    if (answer != wxYES)
        return;

    m_doc.RemoveAllObjectsWithAssetId(assetId);
    m_libraryPanel->RemoveItemById(assetId);

    RefreshPropertiesPanelFromSelection();

    if (m_timelinePanel)
        m_timelinePanel->RefreshAll();

    if (m_canvasPanel && m_canvasPanel->GetViewport())
        m_canvasPanel->GetViewport()->Refresh(false);

    m_libraryPanel->Refresh(false);
}
