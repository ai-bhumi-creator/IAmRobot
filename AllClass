private:
    wxPanel* m_transformSection = nullptr;   // always visible
    wxPanel* m_pathSection = nullptr;        // only for path
    wxPanel* m_textSection = nullptr;        // only for text
    wxPanel* m_imageSection = nullptr;       // optional later

    Document* m_doc = nullptr;
    DisplayObject* m_selected = nullptr;

    wxTextCtrl* xCtrl = nullptr;
    wxTextCtrl* yCtrl = nullptr;
    wxTextCtrl* wCtrl = nullptr;
    wxTextCtrl* hCtrl = nullptr;

    wxPanel* fillColorPreview = nullptr;
    wxPanel* strokeColorPreview = nullptr;

    wxSlider* strokeWidthSlider = nullptr;
    wxTextCtrl* strokeWidthCtrl = nullptr;

    int m_selectedSegmentIndex = -1;

    // Text section
    wxChoice* textFamilyChoice = nullptr;
    wxChoice* textStyleChoice = nullptr;

    wxTextCtrl* textSizeCtrl = nullptr;
    wxTextCtrl* textLetterSpacingCtrl = nullptr;

    wxPanel* textColorPreview = nullptr;
    wxCheckBox* textAutoKernCheck = nullptr;
};
