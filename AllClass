#pragma once

#include <vector>
#include <wx/colour.h>
#include <wx/geometry.h>
#include <wx/graphics.h>

#include "DisplayObject.h"

class PathDisplayObject : public DisplayObject
{
public:
    PathDisplayObject();

    void SetPoints(const std::vector<wxPoint2DDouble>& points) { m_points = points; }
    const std::vector<wxPoint2DDouble>& GetPoints() const { return m_points; }

    void SetClosed(bool closed) { m_closed = closed; }
    bool IsClosed() const { return m_closed; }

    void SetStrokeWidth(double w) { if (w > 0.0) m_strokeWidth = w; }
    double GetStrokeWidth() const { return m_strokeWidth; }

    void SetStrokeColor(const wxColour& c) { m_strokeColor = c; }
    const wxColour& GetStrokeColor() const { return m_strokeColor; }

    void SetFillColor(const wxColour& c) { m_fillColor = c; }
    const wxColour& GetFillColor() const { return m_fillColor; }

    wxRect2DDouble GetLocalBounds() const override;
    bool HitTestWorld(const wxPoint2DDouble& worldPt) const override;
    void Draw(wxGraphicsContext* gc) override;

private:
    std::vector<wxPoint2DDouble> m_points;
    bool m_closed = true;

    double m_strokeWidth = 2.0;
    wxColour m_strokeColor = *wxBLACK;
    wxColour m_fillColor = *wxWHITE;
};

// ========== FILE: PathDisplayObject.cpp ==========
#include "PathDisplayObject.h"

#include <algorithm>
#include <cmath>
#include <limits>
#include <wx/brush.h>
#include <wx/pen.h>

namespace
{
    static double DistSq(const wxPoint2DDouble& a, const wxPoint2DDouble& b)
    {
        const double dx = a.m_x - b.m_x;
        const double dy = a.m_y - b.m_y;
        return dx * dx + dy * dy;
    }

    static double DistancePointToSegment(
        const wxPoint2DDouble& p,
        const wxPoint2DDouble& a,
        const wxPoint2DDouble& b)
    {
        const double vx = b.m_x - a.m_x;
        const double vy = b.m_y - a.m_y;
        const double lenSq = vx * vx + vy * vy;

        if (lenSq <= 1e-12)
            return std::sqrt(DistSq(p, a));

        double t = ((p.m_x - a.m_x) * vx + (p.m_y - a.m_y) * vy) / lenSq;
        t = std::max(0.0, std::min(1.0, t));

        const wxPoint2DDouble proj(a.m_x + vx * t, a.m_y + vy * t);
        return std::sqrt(DistSq(p, proj));
    }
}

PathDisplayObject::PathDisplayObject()
    : DisplayObject(DisplayObjectType::Path)
{
}

wxRect2DDouble PathDisplayObject::GetLocalBounds() const
{
    if (m_points.empty())
        return wxRect2DDouble(0.0, 0.0, 0.0, 0.0);

    double minX = m_points[0].m_x;
    double minY = m_points[0].m_y;
    double maxX = m_points[0].m_x;
    double maxY = m_points[0].m_y;

    for (const auto& p : m_points)
    {
        minX = std::min(minX, p.m_x);
        minY = std::min(minY, p.m_y);
        maxX = std::max(maxX, p.m_x);
        maxY = std::max(maxY, p.m_y);
    }

    const double pad = (m_strokeWidth * 0.5) + 2.0;
    return wxRect2DDouble(
        minX - pad,
        minY - pad,
        (maxX - minX) + pad * 2.0,
        (maxY - minY) + pad * 2.0
    );
}

bool PathDisplayObject::HitTestWorld(const wxPoint2DDouble& worldPt) const
{
    if (m_points.empty())
        return false;

    if (m_points.size() == 1)
    {
        const wxPoint2DDouble wp = TransformPointToWorld(m_points[0]);
        return DistSq(worldPt, wp) <= (6.0 * 6.0);
    }

    constexpr double kHitTolerance = 6.0;

    for (size_t i = 1; i < m_points.size(); ++i)
    {
        const wxPoint2DDouble a = TransformPointToWorld(m_points[i - 1]);
        const wxPoint2DDouble b = TransformPointToWorld(m_points[i]);
        if (DistancePointToSegment(worldPt, a, b) <= kHitTolerance)
            return true;
    }

    if (m_closed && m_points.size() >= 3)
    {
        const wxPoint2DDouble a = TransformPointToWorld(m_points.back());
        const wxPoint2DDouble b = TransformPointToWorld(m_points.front());
        if (DistancePointToSegment(worldPt, a, b) <= kHitTolerance)
            return true;
    }

    return false;
}

void PathDisplayObject::Draw(wxGraphicsContext* gc)
{
    if (!gc || !IsVisible() || m_points.empty())
        return;

    gc->PushState();

    const Transform2D& t = GetTransform();
    const wxPoint2DDouble pos = t.GetPosition();
    const wxPoint2DDouble sc  = t.GetScale();
    const wxPoint2DDouble pv  = t.GetPivot();

    constexpr double kPi = 3.14159265358979323846;
    gc->Translate(pos.m_x, pos.m_y);
    gc->Rotate(t.GetRotation() * kPi / 180.0);
    gc->Scale(sc.m_x, sc.m_y);
    gc->Translate(-pv.m_x, -pv.m_y);

    gc->SetPen(wxPen(m_strokeColor, m_strokeWidth, wxPENSTYLE_SOLID));

    if (m_points.size() == 1)
    {
        const double r = std::max(2.0, m_strokeWidth);
        gc->SetBrush(wxBrush(m_fillColor));
        gc->DrawEllipse(m_points[0].m_x - r, m_points[0].m_y - r, r * 2.0, r * 2.0);
        gc->PopState();
        return;
    }

    wxGraphicsPath path = gc->CreatePath();
    path.MoveToPoint(m_points[0].m_x, m_points[0].m_y);

    for (size_t i = 1; i < m_points.size(); ++i)
        path.AddLineToPoint(m_points[i].m_x, m_points[i].m_y);

    if (m_closed && m_points.size() >= 3)
        path.CloseSubpath();

    if (m_closed && m_points.size() >= 3)
    {
        gc->SetBrush(wxBrush(m_fillColor));
        gc->FillPath(path);
    }
    else
    {
        gc->SetBrush(*wxTRANSPARENT_BRUSH);
    }

    gc->StrokePath(path);
    gc->PopState();
}

