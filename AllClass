#include <wx/pen.h>

#include "ImageObject.h"

ImageObject::ImageObject()
    : DisplayObject(DisplayObjectType::Image)
{
}

void ImageObject::SetBitmap(const wxBitmap& bmp)
{
    m_bitmap = bmp;
    if (m_bitmap.IsOk())
    {
        m_nativeSize = m_bitmap.GetSize();
    }
}

void ImageObject::SetNativeSize(double w, double h)
{
    // wxSize is int-based; local bounds can still use doubles later if you want.
    m_nativeSize = wxSize(static_cast<int>(w), static_cast<int>(h));
}

wxRect2DDouble ImageObject::GetLocalBounds() const
{
    // Convention: local top-left at (0,0)
    return wxRect2DDouble(0.0, 0.0, static_cast<double>(m_nativeSize.GetWidth()), static_cast<double>(m_nativeSize.GetHeight()));
}

bool ImageObject::HitTestWorld(const wxPoint2DDouble& worldPt) const
{
    // Convert world point into local coordinates, then test local bounds
    const wxPoint2DDouble localPt = WorldToLocal(worldPt);
    return GetLocalBounds().Contains(localPt);
}

void ImageObject::Draw(wxGraphicsContext* gc)
{
    if (!gc || !IsVisible())
        return;

    const wxRect2DDouble local = GetLocalBounds();
    if (local.m_width <= 0.0 || local.m_height <= 0.0)
        return;

    gc->PushState();

    // Apply object transform (same order as Transform2D::LocalToWorld):
    // world = T(pos) * R(rot) * S(scale) * T(-pivot) * local
    const Transform2D& t = GetTransform();
    const wxPoint2DDouble pos = t.GetPosition();
    const wxPoint2DDouble sc  = t.GetScale();
    const wxPoint2DDouble pv  = t.GetPivot();
    const double rotDeg       = t.GetRotation();

    constexpr double kPi = 3.14159265358979323846;
    gc->Translate(pos.m_x, pos.m_y);
    gc->Rotate(rotDeg * kPi / 180.0);
    gc->Scale(sc.m_x, sc.m_y);
    gc->Translate(-pv.m_x, -pv.m_y);

    // TODO later: apply opacity in a compositing/render layer path if needed.
    // wxGraphicsContext does not provide a simple universal "SetOpacity" for all draws in all backends.

    if (m_bitmap.IsOk())
    {
        // Draw using local bounds (supports future non-zero local bounds if you want)
        gc->DrawBitmap(m_bitmap, local.m_x, local.m_y, local.m_width, local.m_height);
    }
    else
    {
        // Placeholder when bitmap not assigned yet
        gc->SetBrush(*wxTRANSPARENT_BRUSH);
        gc->SetPen(wxPen(*wxLIGHT_GREY, 1, wxPENSTYLE_SOLID));
        gc->DrawRectangle(local.m_x, local.m_y, local.m_width, local.m_height);

        gc->StrokeLine(local.m_x, local.m_y,
                       local.m_x + local.m_width, local.m_y + local.m_height);

        gc->StrokeLine(local.m_x + local.m_width, local.m_y,
                       local.m_x, local.m_y + local.m_height);
    }

    gc->PopState();
}

