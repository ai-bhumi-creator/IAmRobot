#pragma once

#include "DisplayObject.h"

#include <wx/geometry.h>
#include <wx/graphics.h>

// Handles editor transform interactions (move/rotate/scale) for a selected DisplayObject.
// Centralizes mouse transform logic so SVG/image code stays clean.
class TransformGizmo
{
public:
    enum class Mode
    {
        None,
        Move,
        Rotate,
        ScaleUniform,
        ScaleX,
        ScaleY
    };

    enum class Handle
    {
        None,

        TopLeft,
        Top,
        TopRight,

        Left,
        Right,

        BottomLeft,
        Bottom,
        BottomRight
    };

    TransformGizmo() = default;
    ~TransformGizmo() = default;

    // Selection target
    void SetTarget(DisplayObject* target);
    DisplayObject* GetTarget() { return m_target; }
    const DisplayObject* GetTarget() const { return m_target; }

    void ClearTarget();

    // Interaction state
    bool IsActive() const { return m_active; }
    Mode GetMode() const { return m_mode; }

    // Begin/Update/End mouse interaction in world coordinates
    bool Begin(Mode mode, const wxPoint2DDouble& mouseWorld);
    void Update(const wxPoint2DDouble& mouseWorld);
    void End();

    // Draw gizmo visuals around target
    void Draw(wxGraphicsContext* gc, double zoom);

    // Tweakable settings
    void SetHandleSize(double px) { m_handleSize = px; }
    double GetHandleSize() const { return m_handleSize; }

    Handle HitTestHandles(const wxPoint& mouseClient, double drawX, double drawY, double zoom) const;
    bool IsInRotateZone(const wxPoint& mouseClient, double drawX, double drawY, double zoom) const;

private:
    // Snapshot at interaction start
    struct StartState
    {
        wxPoint2DDouble mouseWorld {0.0, 0.0};
        wxPoint2DDouble objPos     {0.0, 0.0};
        wxPoint2DDouble objScale   {1.0, 1.0};
        double objRotationDeg = 0.0;

        wxPoint2DDouble pivotLocal {0.0, 0.0};
        wxPoint2DDouble pivotWorld {0.0, 0.0};

        wxRect2DDouble worldBounds;
    };

    void UpdateMove(const wxPoint2DDouble& mouseWorld);
    void UpdateRotate(const wxPoint2DDouble& mouseWorld);
    void UpdateScale(const wxPoint2DDouble& mouseWorld);

    // math helpers
    static double AngleDeg(const wxPoint2DDouble& center, const wxPoint2DDouble& p);
    static double Distance(const wxPoint2DDouble& a, const wxPoint2DDouble& b);

private:
    DisplayObject* m_target = nullptr;

    bool m_active = false;
    Mode m_mode = Mode::None;

    StartState m_start;

    double m_handleSize = 8.0;
};


// ========== FILE: TransformGizmo.cpp ==========
#include "TransformGizmo.h"

#include <cmath>
#include <algorithm>
#include <wx/pen.h>
#include <wx/brush.h>

namespace
{
    constexpr double kPi = 3.14159265358979323846;

    inline double RadToDeg(double r)
    {
        return r * 180.0 / kPi;
    }
}

void TransformGizmo::SetTarget(DisplayObject* target)
{
    // If changing target during active drag, stop interaction safely
    if (m_active)
        End();

    m_target = target;
}

void TransformGizmo::ClearTarget()
{
    if (m_active)
        End();

    m_target = nullptr;
}

bool TransformGizmo::Begin(Mode mode, const wxPoint2DDouble& mouseWorld)
{
    if (!m_target) return false;
    if (mode == Mode::None) return false;
    if (m_target->IsLocked()) return false;

    m_mode = mode;
    m_active = true;

    m_start.mouseWorld = mouseWorld;
    m_start.objPos = m_target->GetPosition();
    m_start.objScale = m_target->GetScale();
    m_start.objRotationDeg = m_target->GetRotation();
    m_start.pivotLocal = m_target->GetPivot();
    m_start.pivotWorld = m_target->GetTransform().LocalToWorld(m_start.pivotLocal);
    m_start.worldBounds = m_target->GetWorldBounds();

    return true;
}

void TransformGizmo::Update(const wxPoint2DDouble& mouseWorld)
{
    if (!m_active || !m_target) return;

    switch (m_mode)
    {
    case Mode::Move:
        UpdateMove(mouseWorld);
        break;
    case Mode::Rotate:
        UpdateRotate(mouseWorld);
        break;
    case Mode::ScaleUniform:
    case Mode::ScaleX:
    case Mode::ScaleY:
        UpdateScale(mouseWorld);
        break;
    default:
        break;
    }
}

void TransformGizmo::End()
{
    m_active = false;
    m_mode = Mode::None;
}

TransformGizmo::Handle TransformGizmo::HitTestHandles(const wxPoint& mouseClient, double drawX, double drawY, double zoom) const
{
    if (!m_target || zoom <= 0.0)
        return Handle::None;

    const wxRect2DDouble local = m_target->GetLocalBounds();

    const wxPoint2DDouble p1w = m_target->TransformPointToWorld(wxPoint2DDouble(local.m_x, local.m_y));
    const wxPoint2DDouble p2w = m_target->TransformPointToWorld(wxPoint2DDouble(local.m_x + local.m_width, local.m_y));
    const wxPoint2DDouble p3w = m_target->TransformPointToWorld(wxPoint2DDouble(local.m_x + local.m_width, local.m_y + local.m_height));
    const wxPoint2DDouble p4w = m_target->TransformPointToWorld(wxPoint2DDouble(local.m_x, local.m_y + local.m_height));

    const wxPoint2DDouble topMidW   ((p1w.m_x + p2w.m_x) * 0.5, (p1w.m_y + p2w.m_y) * 0.5);
    const wxPoint2DDouble rightMidW ((p2w.m_x + p3w.m_x) * 0.5, (p2w.m_y + p3w.m_y) * 0.5);
    const wxPoint2DDouble bottomMidW((p3w.m_x + p4w.m_x) * 0.5, (p3w.m_y + p4w.m_y) * 0.5);
    const wxPoint2DDouble leftMidW  ((p4w.m_x + p1w.m_x) * 0.5, (p4w.m_y + p1w.m_y) * 0.5);

    auto worldToClient = [&](const wxPoint2DDouble& p) -> wxPoint2DDouble
    {
        return wxPoint2DDouble(
            drawX + p.m_x * zoom,
            drawY + p.m_y * zoom
        );
    };

    const wxPoint2DDouble p1 = worldToClient(p1w);
    const wxPoint2DDouble p2 = worldToClient(p2w);
    const wxPoint2DDouble p3 = worldToClient(p3w);
    const wxPoint2DDouble p4 = worldToClient(p4w);
    const wxPoint2DDouble topMid = worldToClient(topMidW);
    const wxPoint2DDouble rightMid = worldToClient(rightMidW);
    const wxPoint2DDouble bottomMid = worldToClient(bottomMidW);
    const wxPoint2DDouble leftMid = worldToClient(leftMidW);

    const double handleSizePx = 8.0;
    const double half = handleSizePx * 0.5;

    auto hitRect = [&](const wxPoint2DDouble& p) -> bool
    {
        return mouseClient.x >= (p.m_x - half) &&
               mouseClient.x <= (p.m_x + half) &&
               mouseClient.y >= (p.m_y - half) &&
               mouseClient.y <= (p.m_y + half);
    };

    if (hitRect(p1))      return Handle::TopLeft;
    if (hitRect(topMid))  return Handle::Top;
    if (hitRect(p2))      return Handle::TopRight;

    if (hitRect(leftMid)) return Handle::Left;
    if (hitRect(rightMid))return Handle::Right;

    if (hitRect(p4))      return Handle::BottomLeft;
    if (hitRect(bottomMid)) return Handle::Bottom;
    if (hitRect(p3))      return Handle::BottomRight;

    return Handle::None;
}

void TransformGizmo::Draw(wxGraphicsContext* gc, double zoom)
{
    if (!gc || !m_target)
        return;

    if (zoom <= 0.0)
        zoom = 1.0;

    const wxRect2DDouble local = m_target->GetLocalBounds();

    const wxPoint2DDouble p1 = m_target->TransformPointToWorld(wxPoint2DDouble(local.m_x, local.m_y));
    const wxPoint2DDouble p2 = m_target->TransformPointToWorld(wxPoint2DDouble(local.m_x + local.m_width, local.m_y));
    const wxPoint2DDouble p3 = m_target->TransformPointToWorld(wxPoint2DDouble(local.m_x + local.m_width, local.m_y + local.m_height));
    const wxPoint2DDouble p4 = m_target->TransformPointToWorld(wxPoint2DDouble(local.m_x, local.m_y + local.m_height));

    const wxPoint2DDouble topMid((p1.m_x + p2.m_x) * 0.5, (p1.m_y + p2.m_y) * 0.5);
    const wxPoint2DDouble rightMid((p2.m_x + p3.m_x) * 0.5, (p2.m_y + p3.m_y) * 0.5);
    const wxPoint2DDouble bottomMid((p3.m_x + p4.m_x) * 0.5, (p3.m_y + p4.m_y) * 0.5);
    const wxPoint2DDouble leftMid((p4.m_x + p1.m_x) * 0.5, (p4.m_y + p1.m_y) * 0.5);

    const double stroke = 2.0 / zoom;
    const double handleSize = 8.0 / zoom;
    const double half = handleSize * 0.5;

    wxColour anchorColor(0, 120, 215);

    auto drawHandle = [&](const wxPoint2DDouble& p)
    {
        gc->DrawRectangle(p.m_x - half, p.m_y - half, handleSize, handleSize);
    };

    gc->PushState();

    // rotated box
    gc->SetBrush(*wxTRANSPARENT_BRUSH);
    gc->SetPen(wxPen(anchorColor, stroke, wxPENSTYLE_SOLID));
    gc->StrokeLine(p1.m_x, p1.m_y, p2.m_x, p2.m_y);
    gc->StrokeLine(p2.m_x, p2.m_y, p3.m_x, p3.m_y);
    gc->StrokeLine(p3.m_x, p3.m_y, p4.m_x, p4.m_y);
    gc->StrokeLine(p4.m_x, p4.m_y, p1.m_x, p1.m_y);

    // 8 handles
    gc->SetPen(wxPen(anchorColor, stroke));
    gc->SetBrush(wxBrush(anchorColor));

    drawHandle(p1);       // top-left
    drawHandle(topMid);   // top
    drawHandle(p2);       // top-right

    drawHandle(leftMid);  // left
    drawHandle(rightMid); // right

    drawHandle(p4);       // bottom-left
    drawHandle(bottomMid);// bottom
    drawHandle(p3);       // bottom-right

    gc->PopState();
}

void TransformGizmo::UpdateMove(const wxPoint2DDouble& mouseWorld)
{
    if (!m_target) return;

    const double dx = mouseWorld.m_x - m_start.mouseWorld.m_x;
    const double dy = mouseWorld.m_y - m_start.mouseWorld.m_y;

    m_target->SetPosition(m_start.objPos.m_x + dx, m_start.objPos.m_y + dy);
}

void TransformGizmo::UpdateRotate(const wxPoint2DDouble& mouseWorld)
{
    if (!m_target) return;

    const double a0 = AngleDeg(m_start.pivotWorld, m_start.mouseWorld);
    const double a1 = AngleDeg(m_start.pivotWorld, mouseWorld);
    const double delta = a1 - a0;

    m_target->SetRotation(m_start.objRotationDeg + delta);
}

void TransformGizmo::UpdateScale(const wxPoint2DDouble& mouseWorld)
{
    if (!m_target) return;

    // Simple distance-based scaling around pivot (skeleton behavior).
    // Later you can replace with proper handle-axis projection scaling.
    const double d0 = Distance(m_start.pivotWorld, m_start.mouseWorld);
    const double d1 = Distance(m_start.pivotWorld, mouseWorld);

    if (d0 <= 1e-6) return;

    double ratio = d1 / d0;

    // prevent collapsing/inversion at this stage (you can allow negatives later if needed)
    ratio = std::max(0.01, ratio);

    double sx = m_start.objScale.m_x;
    double sy = m_start.objScale.m_y;

    switch (m_mode)
    {
    case Mode::ScaleUniform:
        sx *= ratio;
        sy *= ratio;
        break;
    case Mode::ScaleX:
        sx *= ratio;
        break;
    case Mode::ScaleY:
        sy *= ratio;
        break;
    default:
        break;
    }

    m_target->SetScale(sx, sy);
}

double TransformGizmo::AngleDeg(const wxPoint2DDouble& center, const wxPoint2DDouble& p)
{
    const double dx = p.m_x - center.m_x;
    const double dy = p.m_y - center.m_y;
    return RadToDeg(std::atan2(dy, dx));
}

double TransformGizmo::Distance(const wxPoint2DDouble& a, const wxPoint2DDouble& b)
{
    const double dx = b.m_x - a.m_x;
    const double dy = b.m_y - a.m_y;
    return std::sqrt(dx * dx + dy * dy);
}

bool TransformGizmo::IsInRotateZone(const wxPoint& mouseClient, double drawX, double drawY, double zoom) const
{
    if (!m_target || zoom <= 0.0)
        return false;

    const wxRect2DDouble local = m_target->GetLocalBounds();

    const wxPoint2DDouble p1w = m_target->TransformPointToWorld(wxPoint2DDouble(local.m_x, local.m_y));
    const wxPoint2DDouble p2w = m_target->TransformPointToWorld(wxPoint2DDouble(local.m_x + local.m_width, local.m_y));
    const wxPoint2DDouble p3w = m_target->TransformPointToWorld(wxPoint2DDouble(local.m_x + local.m_width, local.m_y + local.m_height));
    const wxPoint2DDouble p4w = m_target->TransformPointToWorld(wxPoint2DDouble(local.m_x, local.m_y + local.m_height));

    auto worldToClient = [&](const wxPoint2DDouble& p) -> wxPoint2DDouble
    {
        return wxPoint2DDouble(
            drawX + p.m_x * zoom,
            drawY + p.m_y * zoom
        );
    };

    const wxPoint2DDouble p1 = worldToClient(p1w);
    const wxPoint2DDouble p2 = worldToClient(p2w);
    const wxPoint2DDouble p3 = worldToClient(p3w);
    const wxPoint2DDouble p4 = worldToClient(p4w);

    const double handleSizePx = 8.0;
    const double halfHandle = handleSizePx * 0.5;
    const double rotateInnerPx = 8.0;
    const double rotateOuterPx = 18.0;

    auto inCornerRotateZone = [&](const wxPoint2DDouble& p) -> bool
    {
        const double dx = mouseClient.x - p.m_x;
        const double dy = mouseClient.y - p.m_y;

        const double adx = std::abs(dx);
        const double ady = std::abs(dy);

        const bool insideOuter = (adx <= rotateOuterPx && ady <= rotateOuterPx);
        const bool insideInner = (adx <= rotateInnerPx && ady <= rotateInnerPx);
        const bool insideHandle = (adx <= halfHandle && ady <= halfHandle);

        return insideOuter && !insideInner && !insideHandle;
    };

    return inCornerRotateZone(p1) ||
           inCornerRotateZone(p2) ||
           inCornerRotateZone(p3) ||
           inCornerRotateZone(p4);
}

