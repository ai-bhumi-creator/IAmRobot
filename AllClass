namespace
{
    constexpr double kPi = 3.14159265358979323846;
    constexpr double kPenCloseRadiusScreen = 8.0;
    constexpr double kPenPointRadiusScreen = 4.0;

    double AngleDeg(const wxPoint2DDouble& center, const wxPoint2DDouble& p)
    {
        const double dx = p.m_x - center.m_x;
        const double dy = p.m_y - center.m_y;
        return std::atan2(dy, dx) * 180.0 / kPi;
    }

    double DistSq(const wxPoint2DDouble& a, const wxPoint2DDouble& b)
    {
        const double dx = a.m_x - b.m_x;
        const double dy = a.m_y - b.m_y;
        return dx * dx + dy * dy;
    }
}

static void RefreshPropertiesFromMainFrame(wxWindow* w)
{
    MainFrame* frame = wxDynamicCast(wxGetTopLevelParent(w), MainFrame);
    if (!frame)
        return;

    PropertiesPanel* props = frame->GetPropertiesPanel();
    if (!props)
        return;

    frame->RefreshPropertiesPanelFromSelection();

    const Document& doc = frame->GetDocument();
    DisplayObject* selected = doc.GetSelected();

    if (!selected)
    {
        props->UpdateSectionsForSelection(false, false, false);
        return;
    }

    // Multi-selection proxy: hide all type-specific sections
    if (dynamic_cast<GroupProxyObject*>(selected) != nullptr)
    {
        props->UpdateSectionsForSelection(false, false, false);
        return;
    }

    const bool isPath  = dynamic_cast<PathDisplayObject*>(selected) != nullptr;
    const bool isText  = dynamic_cast<TextDisplayObject*>(selected) != nullptr;
    const bool isImage = dynamic_cast<ImageDisplayObject*>(selected) != nullptr;

    props->UpdateSectionsForSelection(isPath, isText, isImage);
}

static wxCursor MakeCursorFromSVG(const char* svg, const wxSize& size, int hotX, int hotY)
{
    wxBitmapBundle bundle = wxBitmapBundle::FromSVG(svg, size);
    wxBitmap bmp = bundle.GetBitmap(size);

    if (!bmp.IsOk())
        return wxCursor(wxCURSOR_ARROW);

    wxImage img = bmp.ConvertToImage();
    if (!img.IsOk())
        return wxCursor(wxCURSOR_ARROW);

    img.SetOption(wxIMAGE_OPTION_CUR_HOTSPOT_X, hotX);
    img.SetOption(wxIMAGE_OPTION_CUR_HOTSPOT_Y, hotY);

    return wxCursor(img);
}

CanvasViewport::CanvasViewport(wxWindow* parent, ViewportBoard* stage, Document* doc)
    : wxPanel(parent, wxID_ANY)
    , m_stage(stage)
    , m_doc(doc)
{
    SetBackgroundStyle(wxBG_STYLE_PAINT);
    SetDoubleBuffered(true);
    SetBackgroundColour(wxColour(170, 170, 170));
    SetCursor(wxCursor(wxCURSOR_ARROW));

    m_circleArrowCursor = MakeCursorFromSVG(SVGImages::CircularArrowCursor, wxSize(30, 30), 15, 15);
}

void CanvasViewport::ApplyToolState(bool pen, bool rectangle, bool ellipse, bool line)
{
    const bool anyDrawTool = pen || rectangle || ellipse || line;

    // Switching to a shape/pen tool: end text editing and disable text tool
    if (anyDrawTool)
    {
        if (m_textEditor)
            CommitTextEdit();

        m_textToolActive = false;
    }

    m_penToolActive = pen;
    m_rectangleToolActive = rectangle;
    m_ellipseToolActive = ellipse;
    m_lineToolActive = line;

    if (anyDrawTool && m_doc)
    {
        m_doc->ClearSelection();
        RefreshPropertiesFromMainFrame(this);
    }

    if (!pen)
        ResetPenPathPreview();

    UpdateToolCursor();
    Refresh(false);
}

bool CanvasViewport::IsDrawToolActive() const
{
    return m_penToolActive || m_rectangleToolActive || m_ellipseToolActive || m_lineToolActive;
}

void CanvasViewport::UpdateToolCursor()
{
    if (m_isPanning)
    {
        SetCursor(wxCursor(wxCURSOR_HAND));
        return;
    }

    if (m_textToolActive)
    {
        SetCursor(wxCursor(wxCURSOR_IBEAM));
        return;
    }

    const bool drawToolActive = m_penToolActive || m_rectangleToolActive || m_ellipseToolActive || m_lineToolActive;

    SetCursor(wxCursor(drawToolActive ? wxCURSOR_CROSS : wxCURSOR_ARROW));
}

wxPoint2DDouble CanvasViewport::ClientToWorld(const wxPoint& pt) const
{
    if (!m_stage)
        return wxPoint2DDouble(0.0, 0.0);

    const wxSize cs = GetClientSize();

    const double boardWf = m_stage->GetWidth()  * m_zoom;
    const double boardHf = m_stage->GetHeight() * m_zoom;

    const double drawX = (cs.x - boardWf) * 0.5 + m_panX;  // ← was missing this
    const double drawY = (cs.y - boardHf) * 0.5 + m_panY;

    return wxPoint2DDouble((static_cast<double>(pt.x) - drawX) / m_zoom, (static_cast<double>(pt.y) - drawY) / m_zoom);
}

void CanvasViewport::SetSubselectionMode(bool active)
{
    if (m_subselectionMode == active)
        return;

    m_subselectionMode = active;

    if (!m_subselectionMode)
        m_subselHover = {};

    Refresh(false);
}

void CanvasViewport::SetTextToolActive(bool on)
{
    // Leaving text tool: commit any active editor
    if (!on && m_textEditor)
        CommitTextEdit();

    m_textToolActive = on;

    if (on)
    {
        // Turn off other draw tools when text is active (so cursor + clicks behave)
        m_penToolActive = false;
        m_rectangleToolActive = false;
        m_ellipseToolActive = false;
        m_lineToolActive = false;

        if (m_doc)
        {
            m_doc->ClearSelection();
            RefreshPropertiesFromMainFrame(this);
        }
    }

    UpdateToolCursor();
    Refresh(false);
}

void CanvasViewport::SetViewFitInWindow()
{
    if (!m_stage)
        return;

    const wxSize cs = GetClientSize();
    const double stageW = static_cast<double>(m_stage->GetWidth());
    const double stageH = static_cast<double>(m_stage->GetHeight());

    if (cs.x <= 0 || cs.y <= 0 || stageW <= 0.0 || stageH <= 0.0)
        return;

    const double padding = 12.0; // small margin on all sides

    const double availW = std::max(1.0, static_cast<double>(cs.x) - padding * 2.0);
    const double availH = std::max(1.0, static_cast<double>(cs.y) - padding * 2.0);

    const double scaleX = availW / stageW;
    const double scaleY = availH / stageH;

    m_zoom = std::min(scaleX, scaleY);
    m_panX = 0.0;
    m_panY = 0.0;

    Refresh();
}

void CanvasViewport::SetViewActualSize()
{
    if (!m_stage)
        return;

    m_zoom = 1.0;
    m_panX = 0.0;
    m_panY = 0.0;

    Refresh();
}

