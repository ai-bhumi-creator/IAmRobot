}

DisplayObject* CanvasViewport::GetTransformTarget() const
{
    if (IsMultiSelectionActive())
        return m_groupProxy.get();
    return m_doc ? m_doc->GetSelected() : nullptr;
}

void CanvasViewport::RebuildGroupProxyFromMultiSel()
{
    if (m_multiSel.size() < 2)
    {
        m_groupProxy.reset();
        return;
    }

    // Union AABB of all selected objects (world space)
    bool first = true;
    double minX=0, minY=0, maxX=0, maxY=0;

    for (DisplayObject* o : m_multiSel)
    {
        if (!o) continue;
        const wxRect2DDouble b = o->GetWorldBounds();
        if (first)
        {
            minX = b.m_x; minY = b.m_y; maxX = b.m_x + b.m_width; maxY = b.m_y + b.m_height;
            first = false;
        }
        else
        {
            minX = std::min(minX, b.m_x);
            minY = std::min(minY, b.m_y);
            maxX = std::max(maxX, b.m_x + b.m_width);
            maxY = std::max(maxY, b.m_y + b.m_height);
        }
    }

    if (first) { m_groupProxy.reset(); return; }

    const double w = maxX - minX;
    const double h = maxY - minY;
    const double cx = minX + w * 0.5;
    const double cy = minY + h * 0.5;

    if (!m_groupProxy)
        m_groupProxy = std::make_unique<GroupProxyObject>();

    // Local rect centered at pivot (so rotation looks correct)
    m_groupProxy->SetLocalRect(wxRect2DDouble(-w * 0.5, -h * 0.5, w, h));
    m_groupProxy->SetPivot(0.0, 0.0);
    m_groupProxy->SetPosition(cx, cy);
    m_groupProxy->SetScale(1.0, 1.0);
    m_groupProxy->SetRotation(0.0);

    // IMPORTANT: gizmo must target proxy (so selection box/handles follow it)
    if (m_doc)
        m_doc->GetGizmo().SetTarget(m_groupProxy.get());
}

void CanvasViewport::SnapshotMultiForTransform()
{
    if (!IsMultiSelectionActive())
        return;

    m_groupStartT = m_groupProxy->GetTransform();
    m_groupStartRotDeg = m_groupProxy->GetRotation();
    m_groupStartScale = m_groupProxy->GetScale();

    m_childStartLocalPos.clear();
    m_childStartScale.clear();
    m_childStartRot.clear();

    m_childStartLocalPos.reserve(m_multiSel.size());
    m_childStartScale.reserve(m_multiSel.size());
    m_childStartRot.reserve(m_multiSel.size());

    for (DisplayObject* o : m_multiSel)
    {
        if (!o) continue;

        const wxPoint2DDouble p0 = o->GetPosition();
        const wxPoint2DDouble localP = m_groupStartT.WorldToLocal(p0);

        m_childStartLocalPos.push_back(localP);
        m_childStartScale.push_back(o->GetScale());
        m_childStartRot.push_back(o->GetRotation());
    }
}

void CanvasViewport::ApplyGroupProxyToChildren()
{
    if (!IsMultiSelectionActive())
        return;

    const Transform2D curT = m_groupProxy->GetTransform();
    const wxPoint2DDouble curScale = m_groupProxy->GetScale();
    const double curRot = m_groupProxy->GetRotation();

    const double sxFactor = (std::abs(m_groupStartScale.m_x) > 1e-9) ? (curScale.m_x / m_groupStartScale.m_x) : 1.0;
    const double syFactor = (std::abs(m_groupStartScale.m_y) > 1e-9) ? (curScale.m_y / m_groupStartScale.m_y) : 1.0;
    const double dRot = curRot - m_groupStartRotDeg;

    // apply to each selected object
    size_t i = 0;
    for (DisplayObject* o : m_multiSel)
    {
        if (!o) { ++i; continue; }

        // Position: map the saved group-local point through CURRENT group transform
        const wxPoint2DDouble newPos = curT.LocalToWorld(m_childStartLocalPos[i]);
        o->SetPosition(newPos.m_x, newPos.m_y);

        // Scale: multiply by group scale factors (Flash-like)
        const wxPoint2DDouble s0 = m_childStartScale[i];
        o->SetScale(s0.m_x * sxFactor, s0.m_y * syFactor);

        // Rotation: add group delta (Flash-like)
        o->SetRotation(m_childStartRot[i] + dRot);

        ++i;
    }
}

wxRect2DDouble CanvasViewport::GetMarqueeStageRect() const
{
    const wxPoint2DDouble a = ClientToStage(m_marqueeStartClient);
    const wxPoint2DDouble b = ClientToStage(m_marqueeCurrentClient);

    const double x = std::min(a.m_x, b.m_x);
    const double y = std::min(a.m_y, b.m_y);
    const double w = std::abs(a.m_x - b.m_x);
    const double h = std::abs(a.m_y - b.m_y);

    return wxRect2DDouble(x, y, w, h);
}

void CanvasViewport::DrawMarquee(wxGraphicsContext* gc)
{
    if (!gc || !m_isMarqueeSelecting)
        return;

    const wxRect2DDouble r = GetMarqueeStageRect();
    if (r.m_width < 1e-6 || r.m_height < 1e-6)
        return;

    const double safeZoom = (m_zoom > 1e-6) ? m_zoom : 1.0;
    const double lineW = 1.0 / safeZoom;

    gc->PushState();
    gc->SetBrush(*wxTRANSPARENT_BRUSH);
    gc->SetPen(wxPen(wxColour(0, 0, 0), lineW, wxPENSTYLE_SOLID));
    gc->DrawRectangle(r.m_x, r.m_y, r.m_width, r.m_height);
    gc->PopState();
}

void CanvasViewport::UpdatePropertiesPanelForSelection()
{
    MainFrame* frame = wxDynamicCast(wxGetTopLevelParent(this), MainFrame);
    if (!frame)
        return;

    PropertiesPanel* props = frame->GetPropertiesPanel();
    if (!props)
        return;

    DisplayObject* selected = m_doc ? m_doc->GetSelected() : nullptr;
    if (!selected)
    {
        props->UpdateSectionsForSelection(false, false, false);
        return;
    }

    const bool isPath  = dynamic_cast<PathDisplayObject*>(selected)  != nullptr;
    const bool isText  = dynamic_cast<TextDisplayObject*>(selected) != nullptr;
    const bool isImage = dynamic_cast<ImageDisplayObject*>(selected) != nullptr;

    props->UpdateSectionsForSelection(isPath, isText, isImage);
}
