CanvasPanel::CanvasPanel(wxWindow* parent, ViewportBoard* stage, Document* doc)
    : wxPanel(parent, wxID_ANY)
    , m_stage(stage)
    , m_doc(doc)
{

    // Top bar
    m_topBar = new wxPanel(this, wxID_ANY);
    m_topBar->SetMinSize(wxSize(-1, 32));
    m_topBar->SetMaxSize(wxSize(-1, 32));

    wxStaticBitmap* canvasIcon = new wxStaticBitmap(m_topBar, wxID_ANY, SVGImages::GetCanvasIconBitmap(wxSize(16, 16)));

    m_sceneLabel = new wxStaticText(m_topBar, wxID_ANY, "Canvas");
    m_sceneLabel->SetForegroundColour(*wxWHITE);

    wxString viewChoices[] = { "Fit in Window", "Actual Size", "Fit Width", "Fit Height" };
    m_viewChoice = new wxChoice(m_topBar, wxID_ANY, wxDefaultPosition, wxDefaultSize, static_cast<int>(sizeof(viewChoices) / sizeof(viewChoices[0])), viewChoices);
    m_viewChoice->SetSelection(0);


    wxBoxSizer* topSizer = new wxBoxSizer(wxHORIZONTAL);
    topSizer->Add(canvasIcon, 0, wxALIGN_CENTER_VERTICAL | wxLEFT, 8);
    topSizer->Add(m_sceneLabel, 0, wxALIGN_CENTER_VERTICAL | wxLEFT, 6);
    topSizer->AddStretchSpacer(1);
    topSizer->Add(m_viewChoice, 0, wxALIGN_CENTER_VERTICAL | wxRIGHT, 8);
    m_topBar->SetSizer(topSizer);

    // Viewport (draws the board)
    m_viewport = new CanvasViewport(this, m_stage, m_doc);

    wxBoxSizer* root = new wxBoxSizer(wxVERTICAL);
    root->Add(m_topBar, 0, wxEXPAND);
    root->Add(m_viewport, 1, wxEXPAND);
    SetSizer(root);
}

void CanvasPanel::ShowBoardSettingsDialog(wxCommandEvent& event)
{
    if (!m_stage)
        return;

    wxDialog dlg(this, wxID_ANY, "Document Properties",
                 wxDefaultPosition, wxDefaultSize,
                 wxDEFAULT_DIALOG_STYLE | wxRESIZE_BORDER);

    // Controls
    wxStaticText* sizeLabel = new wxStaticText(&dlg, wxID_ANY, "Dimension:");
    wxTextCtrl* widthCtrl  = new wxTextCtrl(&dlg, wxID_ANY, wxString::Format("%d", (int)m_stage->GetWidth()));
    wxTextCtrl* heightCtrl = new wxTextCtrl(&dlg, wxID_ANY, wxString::Format("%d", (int)m_stage->GetHeight()));

    wxStaticText* fpsLabel = new wxStaticText(&dlg, wxID_ANY, "Frame Rate:");
    wxSpinCtrl* fpsCtrl = new wxSpinCtrl(&dlg, wxID_ANY);
    fpsCtrl->SetRange(1, 240);
    fpsCtrl->SetValue(m_stage->GetFrameRate());

    wxStaticText* rulerLabel = new wxStaticText(&dlg, wxID_ANY, "Ruler Unit:");
    wxChoice* rulerChoice = new wxChoice(&dlg, wxID_ANY);
    rulerChoice->Append("Pixels");
    rulerChoice->Append("Inches");
    rulerChoice->Append("Centimeters");
    rulerChoice->SetSelection(ViewportBoard::RulerUnitToIndex(m_stage->GetRulerUnit()));

    wxStaticText* colorLabel = new wxStaticText(&dlg, wxID_ANY, "Background:");
    wxColour chosenColor = m_stage->GetBackgroundColor();

    wxPanel* colorSwatch = new wxPanel(&dlg, wxID_ANY, wxDefaultPosition, wxSize(48, 22));
    colorSwatch->SetMinSize(wxSize(48, 22));
    colorSwatch->SetBackgroundColour(chosenColor);
    colorSwatch->SetToolTip("Click to choose color");

    colorSwatch->Bind(wxEVT_LEFT_UP, [&](wxMouseEvent&)
    {
        wxColourData data;
        data.SetColour(chosenColor);

        wxColourDialog colorDlg(&dlg, &data);
        if (colorDlg.ShowModal() == wxID_OK)
        {
            chosenColor = colorDlg.GetColourData().GetColour();
            colorSwatch->SetBackgroundColour(chosenColor);
            colorSwatch->Refresh();
        }
    });

    // Buttons: Default / OK / Cancel
    wxButton* defaultBtn = new wxButton(&dlg, wxID_ANY, "Default");
    wxButton* okBtn = new wxButton(&dlg, wxID_OK, "OK");
    wxButton* cancelBtn = new wxButton(&dlg, wxID_CANCEL, "Cancel");
    okBtn->SetDefault();

    defaultBtn->Bind(wxEVT_BUTTON, [&](wxCommandEvent&)
    {
        widthCtrl->SetValue(wxString::Format("%d", (int)ViewportBoard::DEFAULT_W));
        heightCtrl->SetValue(wxString::Format("%d", (int)ViewportBoard::DEFAULT_H));
        fpsCtrl->SetValue(ViewportBoard::DEFAULT_FRAME_RATE);
        rulerChoice->SetSelection(ViewportBoard::RulerUnitToIndex(ViewportBoard::DEFAULT_RULER_UNIT));
        chosenColor = ViewportBoard::DefaultBackgroundColor();

        colorSwatch->SetBackgroundColour(chosenColor);
        colorSwatch->Refresh();
    });

    // Layout
    wxFlexGridSizer* grid = new wxFlexGridSizer(2, 6, 8);
    grid->AddGrowableCol(1, 1);

    wxBoxSizer* sizeRow = new wxBoxSizer(wxHORIZONTAL);
    sizeRow->Add(widthCtrl, 1, wxRIGHT, 6);
    sizeRow->Add(new wxStaticText(&dlg, wxID_ANY, "x"), 0, wxALIGN_CENTER_VERTICAL | wxRIGHT, 6);
    sizeRow->Add(heightCtrl, 1);

    grid->Add(sizeLabel, 0, wxALIGN_CENTER_VERTICAL);
    grid->Add(sizeRow, 1, wxEXPAND);

    grid->Add(fpsLabel, 0, wxALIGN_CENTER_VERTICAL);
    grid->Add(fpsCtrl, 1, wxEXPAND);

    grid->Add(rulerLabel, 0, wxALIGN_CENTER_VERTICAL);
    grid->Add(rulerChoice, 1, wxEXPAND);

    grid->Add(colorLabel, 0, wxALIGN_CENTER_VERTICAL);
    grid->Add(colorSwatch, 0, wxALIGN_CENTER_VERTICAL);

    wxBoxSizer* buttonSizer = new wxBoxSizer(wxHORIZONTAL);
    buttonSizer->Add(defaultBtn, 0);
    buttonSizer->AddStretchSpacer(1);
    buttonSizer->Add(okBtn, 0, wxRIGHT, 6);
    buttonSizer->Add(cancelBtn, 0);

    wxBoxSizer* root = new wxBoxSizer(wxVERTICAL);
    root->Add(grid, 1, wxEXPAND | wxALL, 12);
    root->Add(buttonSizer, 0, wxEXPAND | wxLEFT | wxRIGHT | wxBOTTOM, 12);

    dlg.SetSizerAndFit(root);
    dlg.CentreOnParent();

    if (dlg.ShowModal() == wxID_OK)
    {
        long w = 0, h = 0;

        if (!widthCtrl->GetValue().ToLong(&w) || w <= 0)  w = (long)ViewportBoard::DEFAULT_W;
        if (!heightCtrl->GetValue().ToLong(&h) || h <= 0) h = (long)ViewportBoard::DEFAULT_H;

        m_stage->SetSize((double)w, (double)h);
        m_stage->SetFrameRate(fpsCtrl->GetValue());
        m_stage->SetRulerUnit(ViewportBoard::RulerUnitFromIndex(rulerChoice->GetSelection()));
        m_stage->SetBackgroundColor(chosenColor);

        if (m_viewport)
            m_viewport->Refresh(false);
    }
}

