void TimelinePanel::FramesPanel::OnSize(wxSizeEvent& e)
{
    Refresh(false);
    e.Skip();
}

void TimelinePanel::FramesPanel::OnPaint(wxPaintEvent& e)
{
    wxAutoBufferedPaintDC dc(this);
    PrepareDC(dc);

    dc.SetBackground(wxBrush(GetBackgroundColour()));
    dc.Clear();

    if (!m_doc)
        return;

    const wxSize cs = GetClientSize();

    int viewStartX = 0, viewStartY = 0;
    GetViewStart(&viewStartX, &viewStartY);

    const int layerCount  = m_doc->GetLayerCount();
    const int totalFrames = m_doc->GetDisplayCellCount();
    const int timelineLen = m_doc->GetTimelineLength();

    // extra blank area after last frame cell
    const int extraCells = 8;
    const int rightPad = extraCells * TimelinePanel::CELL_W;

    const int virtualW = totalFrames * TimelinePanel::CELL_W + rightPad;
    const int virtualH = TimelinePanel::RULER_H + layerCount * TimelinePanel::ROW_H;

    SetVirtualSize(std::max(virtualW, cs.x), std::max(virtualH, cs.y));

    const int visibleFrames = (cs.x > 0) ? (cs.x / TimelinePanel::CELL_W) : 0;
    const int firstFrame = viewStartX;
    const int lastFrame  = std::min(totalFrames, firstFrame + visibleFrames + 2);

    // ----------------------------------------
    // 1) ruler background
    // ----------------------------------------
    dc.SetPen(*wxTRANSPARENT_PEN);
    dc.SetBrush(wxBrush(wxColour(55, 55, 55)));
    dc.DrawRectangle(0, 0, virtualW, TimelinePanel::RULER_H);

    dc.SetTextForeground(*wxWHITE);

    for (int f = firstFrame; f < lastFrame; ++f)
    {
        const int label = f + 1;
        const int x = f * TimelinePanel::CELL_W;

        int tickTop = TimelinePanel::RULER_H - 6;
        if ((label % 10) == 0)
            tickTop = 2;
        else if ((label % 5) == 0)
            tickTop = 6;

        dc.SetPen(wxPen(wxColour(92, 91, 91)));
        dc.DrawLine(x, tickTop, x, TimelinePanel::RULER_H);

        if ((label % 5) == 0)
            dc.DrawText(wxString::Format("%d", label), x + 2, 2);
    }

    dc.SetPen(wxPen(wxColour(80, 80, 80)));
    dc.DrawLine(0, TimelinePanel::RULER_H - 1, virtualW, TimelinePanel::RULER_H - 1);

    // ----------------------------------------
    // 2) frame cells
    // ----------------------------------------
    for (int li = 0; li < layerCount; ++li)
    {
        const int y = TimelinePanel::RULER_H + li * TimelinePanel::ROW_H;
        Layer* L = m_doc->GetLayer(li);

        for (int f = firstFrame; f < lastFrame; ++f)
        {
            const int x = f * TimelinePanel::CELL_W;
            const bool exists = (f < timelineLen);
            const int label = f + 1;

            wxColour fillColor;
            wxColour borderColor;

            if (exists)
            {
                fillColor = wxColour(255, 255, 255);
                borderColor = wxColour(0, 0, 0);
            }
            else
            {
                fillColor = ((label % 5) == 0)
                    ? wxColour(119, 119, 119)
                    : wxColour(81, 81, 81);

                borderColor = wxColour(92, 91, 91);
            }

            dc.SetBrush(wxBrush(fillColor));
            dc.SetPen(wxPen(borderColor, 1));
            dc.DrawRectangle(x, y, TimelinePanel::CELL_W, TimelinePanel::ROW_H);

            // occupied-frame dot only if this frame has objects
            if (exists && L)
            {
                const Frame* fr = L->GetFrame(f);
                if (fr && !fr->GetObjects().empty())
                {
                    const int dotRadius = 2;
                    const int dotPadLeft = 3;
                    const int dotPadBottom = 3;

                    const int dotX = x + dotPadLeft + dotRadius;
                    const int dotY = y + TimelinePanel::ROW_H - dotPadBottom - dotRadius;

                    dc.SetBrush(*wxBLACK_BRUSH);
                    dc.SetPen(*wxTRANSPARENT_PEN);
                    dc.DrawCircle(dotX, dotY, dotRadius);
                }
            }
        }
    }

    // ----------------------------------------
    // 3) playhead only on frames side, never on left header
    // ----------------------------------------
    const int curFrame = m_doc->GetCurrentFrame();
    if (curFrame >= 0 && curFrame < totalFrames)
    {
        const int playCenterX = curFrame * TimelinePanel::CELL_W + (TimelinePanel::CELL_W / 2);

        int dummyX = 0;
        int bottomLogicalY = 0;
        CalcUnscrolledPosition(0, cs.y, &dummyX, &bottomLogicalY);

        dc.SetPen(wxPen(wxColour(220, 0, 0), 1));
        dc.DrawLine(playCenterX, TimelinePanel::RULER_H, playCenterX, bottomLogicalY + 20);

        dc.SetPen(*wxTRANSPARENT_PEN);
        dc.SetBrush(wxBrush(wxColour(220, 0, 0)));

        const int markerW = TimelinePanel::CELL_W - 4;
        const int markerX = playCenterX - markerW / 2;
        const int markerH = TimelinePanel::RULER_H - 14;

        dc.DrawRectangle(markerX, 14, markerW, markerH);
    }
}

void TimelinePanel::FramesPanel::OnLeftDown(wxMouseEvent& e)
{
    if (!m_doc)
        return;

    const wxPoint p = e.GetPosition();

    int viewStartX = 0, viewStartY = 0;
    GetViewStart(&viewStartX, &viewStartY);

    // ruler click
    if (p.y < TimelinePanel::RULER_H)
    {
        const int col = p.x / TimelinePanel::CELL_W;
        if (col < 0)
            return;

        const int frameIndex = viewStartX + col;
        if (!m_doc->CanGoToFrame(frameIndex))
            return;

        m_doc->SetCurrentFrame(frameIndex);

        if (m_owner)
            m_owner->RefreshAll();
        return;
    }

    const int layerIndex = (p.y - TimelinePanel::RULER_H) / TimelinePanel::ROW_H;
    if (layerIndex < 0 || layerIndex >= m_doc->GetLayerCount())
        return;

    const int col = p.x / TimelinePanel::CELL_W;
    if (col < 0)
        return;

    const int frameIndex = viewStartX + col;
    if (!m_doc->CanGoToFrame(frameIndex))
        return;

    m_doc->SetActiveLayerIndex(layerIndex);
    m_doc->SetCurrentFrame(frameIndex);

    if (m_owner)
        m_owner->RefreshAll();
}

