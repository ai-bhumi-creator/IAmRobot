void MainFrame::SetActiveTool(ToolType tool)
{
    m_activeTool = tool;

    if (m_toolSelection)
        m_toolSelection->SetValue(tool == ToolType::Selection);

    if (m_toolSubselection)
        m_toolSubselection->SetValue(tool == ToolType::Subselection);

    if (m_toolPen)
        m_toolPen->SetValue(tool == ToolType::Pen);

    if (m_toolRectangle)
        m_toolRectangle->SetValue(tool == ToolType::Rectangle);

    if (m_toolEllipse)
        m_toolEllipse->SetValue(tool == ToolType::Ellipse);

    if (m_toolLine)
        m_toolLine->SetValue(tool == ToolType::Line);

    if (m_toolText)
        m_toolText->SetValue(tool == ToolType::Text);

    if (m_canvasPanel && m_canvasPanel->GetViewport())
    {
        auto* viewport = m_canvasPanel->GetViewport();
        viewport->SetSubselectionMode(tool == ToolType::Subselection);
        viewport->SetSubToolType(m_subselectionTool);
        viewport->ApplyToolState(tool == ToolType::Pen, tool == ToolType::Rectangle, tool == ToolType::Ellipse, tool == ToolType::Line);
        viewport->SetTextToolActive(tool == ToolType::Text);
    }

    ShowHideSubselectionTool();
}

