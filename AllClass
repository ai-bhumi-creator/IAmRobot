wxPanel* MainFrame::CreatePlaceholderPanel(wxWindow* parent, const wxString& label)
{
    Centre();

    wxPanel* panel = new wxPanel(parent, wxID_ANY);

    wxBoxSizer* sizer = new wxBoxSizer(wxVERTICAL);
    wxStaticText* text = new wxStaticText(panel, wxID_ANY, label);
    text->SetForegroundColour(*wxWHITE);

    sizer->AddSpacer(10);
    sizer->Add(text, 0, wxLEFT | wxTOP, 10);
    panel->SetSizer(sizer);

    return panel;
}

void MainFrame::AddAuiLayout()
{
    constexpr int TOOLBAR_W = 44;
    constexpr int RIGHT_PANEL_W = 280;
    constexpr int TIMELINE_H = 220;

    // -----------------------------
    // Left toolbar pane (outer AUI)
    // -----------------------------
    m_toolsPanel = CreatePlaceholderPanel(this, "");
    m_toolsPanel->SetMinSize(wxSize(TOOLBAR_W, -1));
    m_toolsPanel->SetMaxSize(wxSize(TOOLBAR_W, -1));

    wxBoxSizer* toolsSizer = new wxBoxSizer(wxVERTICAL);

    // Selection tool
    m_toolSelection = new wxBitmapToggleButton(m_toolsPanel, ID_TOOL_SELECTION, MakeSVGToolbarBitmap(SVGImages::SelectionTool, wxSize(20, 20)), wxDefaultPosition, wxSize(32, 32));
    m_toolSubselection = new wxBitmapToggleButton(m_toolsPanel, ID_TOOL_SUBSELECTION, MakeSVGToolbarBitmap(SVGImages::SubselectionTool, wxSize(20, 20)), wxDefaultPosition, wxSize(32, 32));
    m_toolPen = new wxBitmapToggleButton(m_toolsPanel, ID_TOOL_PEN, MakeSVGToolbarBitmap(SVGImages::PenTool, wxSize(20, 20)), wxDefaultPosition, wxSize(32, 32));

    // Since this is the only tool for now, keep it selected by default.
    m_toolSelection->SetValue(m_activeTool == ToolType::Selection);
    m_toolSubselection->SetValue(m_activeTool == ToolType::Subselection);
    m_toolPen->SetValue(m_activeTool == ToolType::Pen);

    toolsSizer->Add(m_toolSelection, 0, wxALL | wxALIGN_TOP | wxALIGN_CENTER_HORIZONTAL, 2);
    toolsSizer->Add(m_toolSubselection, 0, wxALL | wxALIGN_TOP | wxALIGN_CENTER_HORIZONTAL, 2);
    toolsSizer->Add(m_toolPen, 0, wxALL | wxALIGN_TOP | wxALIGN_CENTER_HORIZONTAL, 2);

    m_toolsPanel->SetSizer(toolsSizer);

    // Add toolbar
    m_aui.AddPane(m_toolsPanel, wxAuiPaneInfo().Name("").Caption("").Left().Layer(1).Position(0).MinSize(TOOLBAR_W, 200).BestSize(TOOLBAR_W, 400).MaxSize(TOOLBAR_W, -1).Resizable(true).CloseButton(false).MaximizeButton(false));

    // -----------------------------
    // Right tabs pane (outer AUI)
    // -----------------------------
    m_rightTabs = new wxAuiNotebook(this, wxID_ANY, wxDefaultPosition, wxDefaultSize, wxAUI_NB_TOP | wxAUI_NB_SCROLL_BUTTONS | wxAUI_NB_TAB_MOVE);

    m_propertiesPanel = CreatePlaceholderPanel(m_rightTabs, "PROPERTIES");
    m_libraryPanel    = CreatePlaceholderPanel(m_rightTabs, "LIBRARY");
    m_ColorPanel      = CreatePlaceholderPanel(m_rightTabs, "COLOR");

    m_rightTabs->AddPage(m_propertiesPanel, "PROPERTIES", true);
    m_rightTabs->AddPage(m_libraryPanel, "LIBRARY", false);
    m_rightTabs->AddPage(m_ColorPanel, "COLOR", false);

    m_aui.AddPane(m_rightTabs, wxAuiPaneInfo().Name("right_tabs").Caption("Panels").Right().Layer(1).Position(0).MaximizeButton(false).MinSize(RIGHT_PANEL_W, 200).BestSize(RIGHT_PANEL_W, 400).Resizable(true).CloseButton(true).MaximizeButton(false));

    // -----------------------------
    // Center host pane (outer AUI)
    // -----------------------------
    m_centerHost = new wxPanel(this, wxID_ANY);
    m_centerHost->SetBackgroundColour(wxColour(35, 35, 35));

    m_aui.AddPane(m_centerHost, wxAuiPaneInfo().Name("center_host").CenterPane().PaneBorder(false));

    // -----------------------------
    // Inner AUI manager for center-only docking
    // -----------------------------
    m_centerAui.SetManagedWindow(m_centerHost);
    m_centerAui.SetFlags(wxAUI_MGR_DEFAULT);

    m_canvasPanel = new CanvasPanel(m_centerHost, &m_stage, &m_doc);


    m_timelinePanel = new TimelinePanel(m_centerHost, &m_doc);
    m_timelinePanel->SetMinSize(wxSize(300, 140));
    m_timelinePanel->SetInitialSize(wxSize(-1, TIMELINE_H));

    // Canvas = center of centerHost
    m_centerAui.AddPane(m_canvasPanel, wxAuiPaneInfo().Name("canvas").CenterPane().PaneBorder(false));

    // Timeline = dockable inside centerHost only
    m_centerAui.AddPane(m_timelinePanel, wxAuiPaneInfo().Name("timeline").Caption("Timeline").Bottom().Layer(1).Position(0).Resizable(true).CloseButton(true).MaximizeButton(false).TopDockable(true).BottomDockable(true).LeftDockable(false).RightDockable(false).Floatable(true));

    // Toolbar binding
    Bind(wxEVT_TOGGLEBUTTON, &MainFrame::OnToolSelection, this, ID_TOOL_SELECTION);
    Bind(wxEVT_TOGGLEBUTTON, &MainFrame::OnToolSubselection, this, ID_TOOL_SUBSELECTION);
    Bind(wxEVT_TOGGLEBUTTON, &MainFrame::OnToolPen, this, ID_TOOL_PEN);
}

