static wxBitmap MakeSVGToolbarBitmap(const char* svg, const wxSize& size)
{
    return wxBitmapBundle::FromSVG(svg, size).GetBitmap(size);
}

MainFrame::MainFrame()
    : wxFrame(nullptr, wxID_ANY, "SVG Editor", wxDefaultPosition, wxSize(1366, 768)),
      m_aui(this)
{
    AddMenuBar();
    AddAuiLayout();

    CreateStatusBar(2);
    SetStatusText("Ready...");

    m_aui.Update();
    m_centerAui.Update();
}

MainFrame::~MainFrame()
{
    m_centerAui.UnInit();
    m_aui.UnInit();
}

