#pragma once

#include "Transform2D.h"

#include <string>
#include <wx/geometry.h>
#include <wx/graphics.h>

enum class DisplayObjectType
{
    Image,
    Svg
    // Later: Shape, Text, Group, etc.
};

// Base scene object class.
// Tools/timeline should mostly talk to DisplayObject*, not raw SVG/image internals.
class DisplayObject
{
public:
    DisplayObject(DisplayObjectType type);
    virtual ~DisplayObject();

    // Non-copyable for now (safer with polymorphism/ownership)
    DisplayObject(const DisplayObject&) = delete;
    DisplayObject& operator=(const DisplayObject&) = delete;

    // Movable if needed later
    DisplayObject(DisplayObject&&) = default;
    DisplayObject& operator=(DisplayObject&&) = default;

    // --- Identity / Metadata ---
    void SetId(const std::string& id) { m_id = id; }
    const std::string& GetId() const { return m_id; }

    void SetName(const std::string& name) { m_name = name; }
    const std::string& GetName() const { return m_name; }

    DisplayObjectType GetType() const { return m_type; }

    // --- Common state ---
    void SetVisible(bool v) { m_visible = v; }
    bool IsVisible() const { return m_visible; }

    void SetLocked(bool v) { m_locked = v; }
    bool IsLocked() const { return m_locked; }

    void SetOpacity(double alpha); // 0..1
    double GetOpacity() const { return m_opacity; }

    // --- Transform API (engine-like helpers) ---
    void SetPosition(double x, double y) { m_transform.SetPosition(x, y); }
    void SetScale(double sx, double sy) { m_transform.SetScale(sx, sy); }
    void SetRotation(double degrees) { m_transform.SetRotation(degrees); }

    const wxPoint2DDouble& GetPosition() const { return m_transform.GetPosition(); }
    const wxPoint2DDouble& GetScale() const { return m_transform.GetScale(); }
    double GetRotation() const { return m_transform.GetRotation(); }

    void SetPivot(double x, double y) { m_transform.SetPivot(x, y); }
    const wxPoint2DDouble& GetPivot() const { return m_transform.GetPivot(); }

    Transform2D& GetTransform() { return m_transform; }
    const Transform2D& GetTransform() const { return m_transform; }

    // --- Bounds / Hit Test ---
    // Local bounds are in object local space (before Transform2D is applied)
    virtual wxRect2DDouble GetLocalBounds() const = 0;

    // World bounds (AABB after transform)
    virtual wxRect2DDouble GetWorldBounds() const;

    // Hit test with point in world coordinates
    virtual bool HitTestWorld(const wxPoint2DDouble& worldPt) const = 0;

    // --- Drawing ---
    // Draw object content using its own transform (or caller can manage transform stack if preferred)
    virtual void Draw(wxGraphicsContext* gc) = 0;

    // Optional editor visuals
    virtual void DrawSelection(wxGraphicsContext* gc, double zoom);

    wxPoint2DDouble TransformPointToWorld(const wxPoint2DDouble& p) const { return m_transform.LocalToWorld(p); }

protected:
    // Utility for derived classes: transform a local point to world
    wxPoint2DDouble LocalToWorld(const wxPoint2DDouble& p) const
    {
        return m_transform.LocalToWorld(p);
    }

    // Utility for derived classes: transform a world point to local
    wxPoint2DDouble WorldToLocal(const wxPoint2DDouble& p) const
    {
        return m_transform.WorldToLocal(p);
    }

private:
    std::string m_id;
    std::string m_name;
    DisplayObjectType m_type;

    bool   m_visible = true;
    bool   m_locked = false;
    double m_opacity = 1.0; // 0..1

    Transform2D m_transform;
};

// ========== FILE: DisplayObject.cpp ==========
#include <algorithm>
#include <wx/pen.h>

#include "DisplayObject.h"

DisplayObject::DisplayObject(DisplayObjectType type)
    : m_type(type)
{
}

DisplayObject::~DisplayObject() = default;

void DisplayObject::SetOpacity(double alpha)
{
    m_opacity = std::max(0.0, std::min(1.0, alpha));
}

wxRect2DDouble DisplayObject::GetWorldBounds() const
{
    // AABB from transformed local rect corners
    const wxRect2DDouble local = GetLocalBounds();

    wxPoint2DDouble p1(local.m_x,                 local.m_y);
    wxPoint2DDouble p2(local.m_x + local.m_width, local.m_y);
    wxPoint2DDouble p3(local.m_x + local.m_width, local.m_y + local.m_height);
    wxPoint2DDouble p4(local.m_x,                 local.m_y + local.m_height);

    p1 = m_transform.LocalToWorld(p1);
    p2 = m_transform.LocalToWorld(p2);
    p3 = m_transform.LocalToWorld(p3);
    p4 = m_transform.LocalToWorld(p4);

    const double minX = std::min(std::min(p1.m_x, p2.m_x), std::min(p3.m_x, p4.m_x));
    const double minY = std::min(std::min(p1.m_y, p2.m_y), std::min(p3.m_y, p4.m_y));
    const double maxX = std::max(std::max(p1.m_x, p2.m_x), std::max(p3.m_x, p4.m_x));
    const double maxY = std::max(std::max(p1.m_y, p2.m_y), std::max(p3.m_y, p4.m_y));

    return wxRect2DDouble(minX, minY, maxX - minX, maxY - minY);
}

void DisplayObject::DrawSelection(wxGraphicsContext* gc, double zoom)
{
    if (!gc) return;

    if (zoom <= 0.0)
        zoom = 1.0;

    const wxRect2DDouble local = GetLocalBounds();

    const wxPoint2DDouble p1 = TransformPointToWorld(wxPoint2DDouble(local.m_x, local.m_y));
    const wxPoint2DDouble p2 = TransformPointToWorld(wxPoint2DDouble(local.m_x + local.m_width, local.m_y));
    const wxPoint2DDouble p3 = TransformPointToWorld(wxPoint2DDouble(local.m_x + local.m_width, local.m_y + local.m_height));
    const wxPoint2DDouble p4 = TransformPointToWorld(wxPoint2DDouble(local.m_x, local.m_y + local.m_height));

    const double stroke = 1.0 / zoom;

    gc->PushState();
    gc->SetBrush(*wxTRANSPARENT_BRUSH);
    gc->SetPen(wxPen(*wxWHITE, stroke, wxPENSTYLE_SHORT_DASH));

    gc->StrokeLine(p1.m_x, p1.m_y, p2.m_x, p2.m_y);
    gc->StrokeLine(p2.m_x, p2.m_y, p3.m_x, p3.m_y);
    gc->StrokeLine(p3.m_x, p3.m_y, p4.m_x, p4.m_y);
    gc->StrokeLine(p4.m_x, p4.m_y, p1.m_x, p1.m_y);

    gc->PopState();
}

